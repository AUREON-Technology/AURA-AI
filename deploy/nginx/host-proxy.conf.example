# Host-nginx vhost for a shared box (Velvet already owns 80/443).
#
# Copy to /etc/nginx/sites-available/aura, then:
#   1. Replace __AURA_DOMAIN__ with the same hostname as deploy/.env AURA_DOMAIN.
#      That name IS the Flutter client's BACKEND_URL host. They must match, and
#      the Let's Encrypt leaf must list it as a SAN.
#   2. The `gateway` container publishes no port by default (SEC-12: "only Nginx
#      publishes a port" -- see docker-compose.prod.yml and aura.conf.template).
#      Using this file means host-nginx is standing in for the bundled nginx
#      container, so gateway needs a loopback port bound first. Create
#      deploy/docker-compose.override.yml (do not edit docker-compose.prod.yml
#      itself) containing:
#        services:
#          gateway:
#            ports:
#              - "127.0.0.1:${GATEWAY_PORT}:8000"
#          nginx:
#            profiles: ["bundled-edge"]
#      then `docker compose -f docker-compose.prod.yml -f docker-compose.override.yml
#      up -d` (pick a free ${GATEWAY_PORT} via `ss -tlnp` / `nginx -T` -- not 80,
#      443, or Velvet's 8000).
#
#      The `profiles` entry is what keeps the bundled nginx off this box. Naming a
#      profile the stack never enables excludes the service from `up` without
#      deleting it, so `docker compose config --services` returns gateway alone and
#      nothing contends for 80/443. Set COMPOSE_PROFILES=bundled-edge to bring it
#      back on a host that does own the edge.
#   3. Replace __GATEWAY_PORT__ below with that same port.
#   4. ln -s /etc/nginx/sites-available/aura /etc/nginx/sites-enabled/aura
#   5. nginx -t && systemctl reload nginx
#
# Use the same hostname as AURA_DOMAIN. That is the production domain
# (aureon-ai.tech), not a bare IP. Issue the cert for that
# name, then rebuild the client:
#   ./deploy_client.sh
#
# Do NOT delete the `nginx` service from docker-compose.prod.yml to achieve this.
# That edit leaves the checkout dirty, and deploy/scripts/vps-update.sh refuses to
# run against a modified tree -- so hand-editing the tracked file does not merely
# risk being overwritten, it blocks every future automated deploy. The profile in the
# override above does the same job and leaves the tree clean.
#
# vps-update.sh passes the override through automatically: it picks up a
# docker-compose.override.yml sitting beside the compose file, and preserves every
# file a running stack reports. AURA_COMPOSE_OVERRIDE names one kept elsewhere.
#
# The security headers, rate limiting, and TLS hardening below mirror
# deploy/nginx/templates/aura.conf.template (the bundled-nginx equivalent) --
# this file existing to support a different ingress is not a reason to ship
# it with a weaker posture.

# ---------------------------------------------------------------- HTTP: ACME + redirect
server {
    listen 80;
    listen [::]:80;
    server_name __AURA_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------- HTTPS
# Coarse connection-level limits. Zones are shared across workers -- real,
# cost-weighted, per-user limiting still happens inside the gateway; this is
# only a pre-filter.
limit_req_zone $binary_remote_addr zone=aura_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=aura_chat:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=aura_conn:10m;

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    # http2 deliberately NOT enabled -- see the matching comment in
    # deploy/nginx/templates/aura.conf.template. A client whose ALPN offers h2 (curl and
    # Dart's dart:io WebSocket client both do, by default) gets negotiated onto HTTP/2 for
    # this whole server block, and HTTP/2 forbids the legacy Connection/Upgrade header
    # fields the WebSocket location below relies on -- the handshake silently degrades to a
    # plain GET, which 404s. Plain HTTP/1.1 is worth more here than h2's multiplexing.
    server_name __AURA_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__AURA_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__AURA_DOMAIN__/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/__AURA_DOMAIN__/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;   # TLS 1.3 ciphers are fixed; client preference is fine
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;         # session tickets weaken forward secrecy
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=30s;   # adjust if host-nginx isn't behind Docker's DNS

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # The API serves JSON and SSE only; a default-deny CSP costs nothing and blocks a whole
    # class of mistakes if an HTML error page is ever introduced.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    server_tokens off;
    client_max_body_size 20m;        # matches the gateway's document size ceiling
    client_body_timeout 30s;
    limit_conn aura_conn 24;

    # SSE: buffering here holds tokens until the response completes.
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    # Live voice WebSocket. Must sit before the catch-all / location: that block
    # sets Connection "" and would kill the Upgrade handshake (same as the bundled
    # aura.conf.template block).
    location /api/v3/voice/live {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Desktop Engineer host daemon WebSocket (ADR-011). Same WS-vs-catch-all conflict as
    # voice/live above -- must sit before the catch-all / location.
    location /api/v3/host/agent {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location /api/v3/chat/stream {
        limit_req zone=aura_chat burst=5 nodelay;

        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        chunked_transfer_encoding on;
    }

    # ------------------------------------------------------------ metrics: never public
    # Prometheus scrapes the gateway directly; exposing /metrics publicly leaks
    # provider names, model names, cost, and traffic volume.
    location /metrics {
        deny all;
        return 404;
    }

    # Operator console. Publish the console container on loopback in
    # docker-compose.override.yml as 127.0.0.1:__CONSOLE_PORT__:3000.
    # Prefix match — do not 302 /console → /console/. Next 308s the other
    # way and the pair loops (ERR_TOO_MANY_REDIRECTS) after console login.
    location /console {
        proxy_pass http://127.0.0.1:__CONSOLE_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' https://accounts.google.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'self'" always;
    }

    location / {

        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
