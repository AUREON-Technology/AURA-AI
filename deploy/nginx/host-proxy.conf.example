# Host-nginx vhost for a shared box (Velvet already owns 80/443).
#
# Copy to /etc/nginx/sites-available/aura, then:
#   1. Replace __AURA_DOMAIN__ with the same hostname as deploy/.env AURA_DOMAIN.
#      That name IS the Flutter client's BACKEND_URL host. They must match, and
#      the Let's Encrypt leaf must list it as a SAN.
#   2. Replace __GATEWAY_PORT__ with the loopback port the gateway publishes
#      (not 80, 443, or Velvet's 8000). Pick a free port from `ss -tlnp` / `nginx -T`.
#   3. ln -s /etc/nginx/sites-available/aura /etc/nginx/sites-enabled/aura
#   4. nginx -t && systemctl reload nginx
#
# Use the same hostname as AURA_DOMAIN. With no owned domain that is the VPS
# nip.io name (169.58.188.43.nip.io), not a bare IP. Issue the cert for that
# name, then rebuild the client:
#   ./deploy_client.sh
#
# Remove the `nginx` service from docker-compose.prod.yml when using this file;
# the compose stack must not publish 80/443.

# ---------------------------------------------------------------- HTTP: ACME + redirect
server {
    listen 80;
    listen [::]:80;
    server_name __AURA_DOMAIN__;

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------- HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name __AURA_DOMAIN__;

    ssl_certificate     /etc/letsencrypt/live/__AURA_DOMAIN__/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/__AURA_DOMAIN__/privkey.pem;

    # SSE: buffering here holds tokens until the response completes.
    proxy_buffering off;
    proxy_read_timeout 300s;
    proxy_send_timeout 300s;

    location /api/v3/chat/stream {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_buffering off;
        proxy_cache off;
        gzip off;
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        chunked_transfer_encoding on;
    }

    location / {
        proxy_pass http://127.0.0.1:__GATEWAY_PORT__;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;
        proxy_set_header X-Forwarded-For   $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
