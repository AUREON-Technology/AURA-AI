# AURA ingress. The only container with a published port (SEC-12).
#
# ${AURA_DOMAIN} is also the Flutter client's BACKEND_URL host. The certificate
# SAN, this server_name, and --dart-define=BACKEND_URL=https://${AURA_DOMAIN} must
# be the same string. On a shared host where Velvet already owns 80/443, do not
# start this container — use deploy/nginx/host-proxy.conf.example instead.
#
# Three things here are not boilerplate and are worth reading:
#
# 1. SSE requires buffering off and a long read timeout. With Nginx's defaults the whole
#    streamed answer arrives at once when the response completes, which silently removes the
#    feature the client was built around.
# 2. X-Forwarded-For is *set*, not appended, for the client address, and the gateway is told
#    exactly one proxy is trusted. The header is client-controlled, so a chain the gateway
#    cannot reason about is a rate-limit bypass.
# 3. Rate limiting here is a coarse pre-filter only. Real limiting is cost-weighted and
#    per-user inside the gateway; Nginx cannot know that a chat turn costs twenty times a
#    health check.
#
# This file is a *.template*, not a plain .conf: it is rendered by the official nginx image's
# entrypoint (20-envsubst-on-templates.sh), which envsubst's it into /etc/nginx/conf.d/aura.conf
# on container start. NGINX_ENVSUBST_FILTER=^AURA_DOMAIN$ on the nginx service restricts that
# substitution to exactly this one variable -- everything else below with a leading '$' is an
# nginx runtime variable ($host, $request_uri, ...) and must NOT be touched, which an
# unrestricted envsubst would otherwise do by replacing every $name it finds with an empty
# string.

# Coarse connection-level limits. Zones are shared across workers.
limit_req_zone $binary_remote_addr zone=aura_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=aura_chat:10m rate=2r/s;
limit_conn_zone $binary_remote_addr zone=aura_conn:10m;

upstream aura_gateway {
    server gateway:8000 max_fails=3 fail_timeout=15s;
    keepalive 32;
}

upstream aura_grafana {
    server grafana:3000;
    keepalive 4;
}

upstream aura_console {
    server console:3000;
    keepalive 8;
}

# ---------------------------------------------------------------- HTTP: redirect + ACME
server {
    listen 80;
    listen [::]:80;
    server_name ${AURA_DOMAIN};

    # ACME challenge must stay on HTTP or renewal fails.
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    # Nginx's own health, checked by the container healthcheck. Not proxied, so it stays up
    # while the gateway restarts.
    location = /healthz {
        access_log off;
        return 200 "ok\n";
        add_header Content-Type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---------------------------------------------------------------- HTTPS
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${AURA_DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${AURA_DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${AURA_DOMAIN}/privkey.pem;
    ssl_trusted_certificate /etc/letsencrypt/live/${AURA_DOMAIN}/chain.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;   # TLS 1.3 ciphers are fixed; client preference is fine
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-ECDSA-CHACHA20-POLY1305:ECDHE-RSA-CHACHA20-POLY1305;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;         # session tickets weaken forward secrecy
    ssl_stapling on;
    ssl_stapling_verify on;
    resolver 127.0.0.11 valid=30s;   # Docker's embedded DNS, for OCSP

    add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header X-Frame-Options "DENY" always;
    add_header Referrer-Policy "strict-origin-when-cross-origin" always;
    add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
    # The API serves JSON and SSE only; a default-deny CSP costs nothing and blocks a whole
    # class of mistakes if an HTML error page is ever introduced.
    add_header Content-Security-Policy "default-src 'none'; frame-ancestors 'none'" always;

    server_tokens off;
    client_max_body_size 20m;        # matches the gateway's document size ceiling
    client_body_timeout 30s;
    limit_conn aura_conn 24;

    gzip on;
    gzip_types application/json text/plain;
    gzip_min_length 1024;

    # ------------------------------------------------------------ live voice (WebSocket)
    # Must sit before the generic /api/ location: that block sets Connection "" and would
    # kill the Upgrade handshake. Modelled on the Grafana Live block below.
    location /api/v3/voice/live {
        proxy_pass http://aura_gateway;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_buffering off;
        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # ------------------------------------------------------------ streaming chat
    location /api/v3/chat/stream {
        limit_req zone=aura_chat burst=5 nodelay;

        proxy_pass http://aura_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";

        # Without these three, Nginx buffers the entire SSE response and delivers it in one
        # piece when the upstream closes -- the stream still "works" and is entirely useless.
        proxy_buffering off;
        proxy_cache off;
        gzip off;

        proxy_read_timeout 300s;     # a long agentic turn must not be cut off mid-answer
        proxy_send_timeout 300s;
        chunked_transfer_encoding on;

        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # ------------------------------------------------------------ API
    location /api/ {
        limit_req zone=aura_general burst=20 nodelay;

        proxy_pass http://aura_gateway;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_read_timeout 120s;
        proxy_send_timeout 120s;

        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # ------------------------------------------------------------ health
    location /health/ {
        access_log off;
        proxy_pass http://aura_gateway;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    # ------------------------------------------------------------ metrics: never public
    # Prometheus scrapes the gateway directly over the internal network. Exposing /metrics
    # publicly leaks provider names, model names, cost, and traffic volume.
    location /metrics {
        deny all;
        return 404;
    }

    # ------------------------------------------------------------ operator console
    # Location-level add_header replaces the server-level set, so HSTS/CSP are
    # restated here. /console and /grafana may be framed by each other; /api/
    # keeps the server-level X-Frame-Options DENY.
    # Prefix match — do not 302 /console → /console/. Next (trailingSlash:
    # false) 308s the other way, and the two redirects loop until the browser
    # raises ERR_TOO_MANY_REDIRECTS. Both /console and /console/ must be
    # proxied through to the console container.
    location /console {
        proxy_pass http://aura_console;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_read_timeout 120s;
        include /etc/nginx/conf.d/proxy_headers.inc;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://accounts.google.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' https://accounts.google.com https://oauth2.googleapis.com; frame-src 'self' https://accounts.google.com; frame-ancestors 'self'" always;
    }

    # Cheap session ping so Grafana embeds work for a logged-in operator without
    # publishing Grafana to the public internet.
    location = /_grafana_auth {
        internal;
        proxy_pass http://aura_console/console/api/auth/session;
        proxy_pass_request_body off;
        proxy_set_header Content-Length "";
        proxy_set_header Cookie $http_cookie;
        include /etc/nginx/conf.d/proxy_headers.inc;
    }

    location @grafana_unauth {
        # Named locations inherit server-level X-Frame-Options DENY /
        # frame-ancestors 'none', which turns this 302 into a broken iframe
        # icon. Restate embed-friendly headers so an expired session shows
        # /console/login inside the frame instead.
        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self'; frame-ancestors 'self'" always;
        return 302 /console/login;
    }

    # ------------------------------------------------------------ Grafana, operator session only
    location /grafana/ {
        auth_request /_grafana_auth;
        error_page 401 403 = @grafana_unauth;

        # No trailing slash — GF_SERVER_SERVE_FROM_SUB_PATH mounts Grafana at
        # /grafana/. proxy_pass with a trailing slash would strip that prefix; Grafana then 301s
        # back to ROOT_URL and the console iframe redirect-loops.
        proxy_pass http://aura_grafana;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;   # Grafana Live uses websockets
        proxy_set_header Connection "upgrade";
        include /etc/nginx/conf.d/proxy_headers.inc;

        add_header Strict-Transport-Security "max-age=63072000; includeSubDomains" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "strict-origin-when-cross-origin" always;
        add_header Permissions-Policy "geolocation=(), microphone=(), camera=()" always;
        add_header Content-Security-Policy "default-src 'self' 'unsafe-inline' 'unsafe-eval'; img-src 'self' data:; font-src 'self'; connect-src 'self' ws: wss:; frame-ancestors 'self'" always;
    }

    location / {
        return 404;
    }
}
