{
  "title": "AURA \u2014 Overview",
  "uid": "aura-overview",
  "tags": [
    "aura"
  ],
  "timezone": "utc",
  "refresh": "30s",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Turns per second",
      "type": "timeseries",
      "description": "Throughput split by outcome. A rising 'error' or 'blocked' series is the first signal of trouble.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_turns_total[5m])) by (outcome)",
          "legendFormat": "{{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Turn duration (p50 / p95)",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(aura_turn_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_turn_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Time to first token by provider",
      "type": "timeseries",
      "description": "What users actually perceive as responsiveness.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_llm_ttft_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Pipeline overhead by stage (p95)",
      "type": "timeseries",
      "description": "Everything except model time. Target p95 < 60ms (docs/architecture/00-overview.md \u00a75).",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_stage_duration_seconds_bucket[5m])) by (le, stage))",
          "legendFormat": "{{stage}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Degraded turns",
      "type": "timeseries",
      "description": "Turns that completed on a non-happy path. A system that degrades silently cannot be operated.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_turn_degraded_total[5m])) by (reason)",
          "legendFormat": "{{reason}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Provider health",
      "type": "timeseries",
      "description": "0 means the circuit breaker is open and the provider is out of candidacy.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 14
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "aura_provider_healthy",
          "legendFormat": "{{provider}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Tokens per second",
      "type": "timeseries",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_llm_tokens_total[5m])) by (direction)",
          "legendFormat": "{{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Projected daily spend",
      "type": "stat",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 12,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_llm_cost_usd_total[1h])) * 86400",
          "legendFormat": "USD/day",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "currencyUSD",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 9,
      "title": "Cache hit rate",
      "type": "stat",
      "description": "",
      "gridPos": {
        "h": 7,
        "w": 6,
        "x": 18,
        "y": 21
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_cache_lookups_total{result=\"hit\"}[15m])) / clamp_min(sum(rate(aura_cache_lookups_total[15m])), 0.001)",
          "legendFormat": "hit rate",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 10,
      "type": "row",
      "title": "Inference latency decomposition & admission (P2.4/P2.5)",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "panels": []
    },
    {
      "id": 11,
      "title": "Queue wait p95 by pool",
      "type": "timeseries",
      "description": "Time a generation waited for an admission slot before reaching the model server.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_llm_generation_queue_wait_seconds_bucket[5m])) by (le, pool))",
          "legendFormat": "{{pool}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 12,
      "title": "Time to first token p95 by pool",
      "type": "timeseries",
      "description": "Admission to first streamed token: prefill plus first decode step, excluding queue wait.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 29
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_llm_generation_ttft_seconds_bucket[5m])) by (le, pool))",
          "legendFormat": "{{pool}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 13,
      "title": "Decode time p95 by provider",
      "type": "timeseries",
      "description": "First to last streamed token.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_llm_generation_decode_seconds_bucket[5m])) by (le, provider))",
          "legendFormat": "{{provider}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 14,
      "title": "Total generation time p95 by pool",
      "type": "timeseries",
      "description": "Queue wait plus provider time, successful attempts.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 36
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_llm_generation_total_seconds_bucket{outcome=\"success\"}[5m])) by (le, pool))",
          "legendFormat": "{{pool}} p95",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 15,
      "title": "Output tokens/sec (p50) by provider and model",
      "type": "timeseries",
      "description": "Decode throughput per generation.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.5, sum(rate(aura_llm_generation_tokens_per_second_bucket[5m])) by (le, provider, model))",
          "legendFormat": "{{provider}} {{model}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 16,
      "title": "Tokens by pool and direction",
      "type": "timeseries",
      "description": "Tokens per provider attempt (input/output).",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 43
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_llm_generation_tokens_total[5m])) by (pool, direction)",
          "legendFormat": "{{pool}} {{direction}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 17,
      "title": "Capacity group saturation",
      "type": "timeseries",
      "description": "Slots in use over slots available (1.0 = full), and queued requests.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum by (group) (aura_llm_group_inflight) / clamp_min(sum by (group) (aura_llm_group_capacity), 1)",
          "legendFormat": "{{group}} in use",
          "refId": "A"
        },
        {
          "expr": "sum by (provider) (aura_llm_queue_depth)",
          "legendFormat": "{{provider}} queued",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 18,
      "title": "Admission outcomes",
      "type": "timeseries",
      "description": "admitted / queue_full / queue_timeout / preempted / user_quota / cancelled per second.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 50
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_llm_admission_total[5m])) by (group, outcome)",
          "legendFormat": "{{group}} {{outcome}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 19,
      "title": "HTTP & event outbox (F-24)",
      "type": "row",
      "collapsed": false,
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 57
      },
      "panels": []
    },
    {
      "id": 20,
      "title": "HTTP request duration p95 by route",
      "type": "timeseries",
      "description": "To the last body byte, so /api/v3/chat/stream is the whole stream. Route is the template, never the raw path.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(aura_http_request_duration_seconds_bucket[5m])) by (le, route))",
          "legendFormat": "{{route}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "HTTP requests by status class",
      "type": "timeseries",
      "description": "Includes requests refused before the kernel (auth, rate limit, validation).",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 58
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "sum(rate(aura_http_requests_total[5m])) by (status)",
          "legendFormat": "{{status}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 22,
      "title": "Event outbox backlog",
      "type": "timeseries",
      "description": "Read from the outbox when Prometheus scrapes. Pending should drain to 0 every beat interval.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 0,
        "y": 65
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(aura_outbox_pending)",
          "legendFormat": "pending",
          "refId": "A"
        },
        {
          "expr": "max(aura_outbox_dead_lettered)",
          "legendFormat": "dead-lettered",
          "refId": "B"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {}
        },
        "overrides": []
      }
    },
    {
      "id": 23,
      "title": "Oldest pending outbox event",
      "type": "timeseries",
      "description": "Age of the oldest undelivered durable event; AuraOutboxBacklog fires above 15 minutes.",
      "gridPos": {
        "h": 7,
        "w": 12,
        "x": 12,
        "y": 65
      },
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "targets": [
        {
          "expr": "max(aura_outbox_oldest_pending_age_seconds)",
          "legendFormat": "oldest",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {}
        },
        "overrides": []
      }
    }
  ],
  "schemaVersion": 39,
  "version": 1,
  "editable": true
}
