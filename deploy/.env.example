# Copy to deploy/.env and adjust. Secrets live in deploy/secrets/ as files, never here.

# Hostname TLS is issued for, nginx server_name, AND the Flutter client BACKEND_URL host.
# Production domain (DNS A record must point at the VPS IP).
# Do not use a bare IP — Android/iOS reject that. Rebuild the client after any change:
# ./deploy_client.sh (or deploy_client.ps1).
AURA_DOMAIN=aureon-ai.tech
# Dev subdomain routed by prod nginx to the aura-dev compose stack (parallel Postgres/Qdrant).
AURA_DEV_DOMAIN=dev.aureon-ai.tech
AURA_WORKERS=4
AURA_LOG_LEVEL=INFO

# Deployment environment (aura_core/config/settings.py's Environment enum).
# Valid values: local | development | staging | production.
# docker-compose.prod.yml defaults this to `production` when unset, but an
# explicit wrong value here (e.g. copied from a dev .env) silently overrides
# that default. staging/production are the only values that enable
# is_production_like, which refuses to boot if allow_mock_auth or
# allow_mock_attestation are true (settings.py's validate()) -- so a
# mislabeled environment disables that safety check with no visible error.
# MUST be `production` on the real VPS.
AURA_ENVIRONMENT=production

# Access-token environment binding (F-03, services/jwt_auth.py). Every token is minted with an
# `iss` and `aud` and verified against them. Leave both unset: they default to
# aura-<AURA_ENVIRONMENT> / aura-api-<AURA_ENVIRONMENT>, so prod (aura-production) and the dev
# stack (aura-development) never accept each other's tokens. Set them only to separate two
# deployments of the same environment.
# AURA_JWT_ISSUER=aura-production
# AURA_JWT_AUDIENCE=aura-api-production
# Tokens minted before the binding existed carry neither claim and are accepted until this
# ISO-8601 instant (default 2026-12-15T00:00:00Z; covers 30-day desktop device tokens). Set a past
# date to refuse them now, e.g. right after rotating deploy/secrets/jwt_secret.
# AURA_JWT_LEGACY_TOKENS_UNTIL=2026-12-15T00:00:00Z

# Browser origins allowed to call the API (Flutter web). Native apps ignore CORS.
# Leave unset so compose defaults to localhost + Flutter web ports + https://$AURA_DOMAIN.
# Uncomment and extend only if the web bundle is hosted on another origin (Vercel/Netlify).
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,https://aureon-ai.tech

# Google Identity Services client id baked into the /console image at build time.
# Defaults to the same id as aura_backend.config.Settings.google_client_id.
# GOOGLE_CLIENT_ID=87789110323-5picq501c0834g6g0amjqqpk628jaoh2.apps.googleusercontent.com

# Desktop app ("aura_client" on Linux/Windows) OAuth login audience (ADR-011 Unit 7).
# Defaults to aura_backend.config.Settings.google_desktop_client_id, a separate OAuth client
# registered in the same Google Cloud project. Uncomment only to point at a different registered
# Desktop client than the one hardcoded there -- and keep it equal to the client the app itself
# was built with (aura_client's AppConfig.googleDesktopClientId), or every desktop login fails
# its audience check in services/security.py::verify_identity_token.
# AURA_GOOGLE_DESKTOP_CLIENT_ID=87789110323-pprobmjkf4f16rem4kacr2nqgi9ql1i0.apps.googleusercontent.com

# There is deliberately no GOOGLE_DESKTOP_CLIENT_SECRET key here. Desktop login is a loopback
# OAuth flow against a *public* "Desktop app" client and authenticates with PKCE alone (RFC 8252
# section 8.5) -- a shipped binary cannot keep a secret, so it is not asked to. An earlier build
# did inject one, because the registered client was of the confidential "Web application" type
# and its token endpoint refused a secret-less exchange; the fix was to register the right client
# type, not to distribute a credential.

# Operator allowlists (comma-separated). Must be listed on the gateway service
# in docker-compose.prod.yml or they never reach os.getenv in services.rbac.
# SUPERADMIN_EMAILS is the only list that can mint SuperAdmin. Console login
# requires Developer+. A User is anyone not on these lists (Flutter client only).
# A listed address grants its role only to a Google sign-in whose email is verified
# (email_verified and firebase.sign_in_provider == google.com; SEC-08). An email/password
# or other-provider account with the same address gets nothing from these lists.
SUPERADMIN_EMAILS=
ADMIN_EMAILS=
DEVELOPER_EMAILS=

# Which of the roles above get the "engineer_agent" capability -- required to use the
# `engineer` persona and any of its tools (sandboxed filesystem/command/git, GitHub
# read+write; see the "Engineer agent: GitHub" section further down for the GitHub half of
# this). Comma-separated role names (User, Developer, Admin, SuperAdmin). Empty means nobody
# gets it -- unlike the email lists above, this is not a role assignment but a capability
# grant, and the engineer persona can run shell commands and open PRs on the caller's behalf,
# so it is opt-in per deployment rather than defaulting to Admin/SuperAdmin.
# AURA_ENGINEER_AGENT_ROLES=Developer,Admin,SuperAdmin
# On a host deployed by deploy/scripts/vps-update.sh, this key is set to Admin,SuperAdmin
# when deploy/.env either has no line for it or has one with an empty value -- both grant the
# capability to nobody, and deploy/.env is gitignored, so no pull request can reach it. Give it
# a non-empty value here and the script prints that value and leaves it alone.

# --- LLM providers -----------------------------------------------------------------------
# Comma-separated provider names; each is configured by AURA_PROVIDER_<NAME>_* variables.
# The compose file pre-configures `local` against the bundled Ollama container.
AURA_LLM_PROVIDERS=local
# Default is the 3B Q4 quant: this VPS is CPU-only (8 cores, no NVIDIA). A 7B Q4 with
# OLLAMA_NUM_PARALLEL=2 was starving the box and timing out chat. Keep the 7B weights
# installed if already pulled; switch AURA_LOCAL_MODEL (and AURA_PROVIDER_LOCAL_MODEL)
# back to the 7B tag when a GPU host is available. Compose prefers
# AURA_PROVIDER_LOCAL_MODEL, then AURA_LOCAL_MODEL.
AURA_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_LLM_ROUTING_POLICY=local_first
# Router deadline and the local provider HTTP client. CPU generation of even 3B-Q4
# routinely exceeds the 60s library default; nginx SSE already allows 300s.
AURA_LLM_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_TIMEOUT_S=180

# To add a second provider for quality-sensitive turns, extend the list. It must be another
# endpoint you host: `kind` accepts only `openai_compatible`, `ollama` and `echo`, and a
# `base_url` pointing at a hosted inference API is rejected at construction. A larger model on
# a GPU box is the intended use -- see docs/reports/OLLAMA_VLLM_COMPARISON.md §4 (Option B)
# and docs/guides/gpu-hybrid-setup.md for the full walkthrough, including the optional `vllm`
# compose service (bring up with `--profile gpu`) this block is meant to pair with.
#   AURA_LLM_PROVIDERS=local,large
#   AURA_PROVIDER_LARGE_KIND=openai_compatible
#   AURA_PROVIDER_LARGE_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
#   AURA_PROVIDER_LARGE_BASE_URL=http://vllm:8000/v1
#   AURA_PROVIDER_LARGE_QUALITY_TIER=3
#   AURA_PROVIDER_LARGE_TIMEOUT_S=180
#   AURA_PROVIDER_LARGE_MAX_CONCURRENCY=4
#   AURA_PROVIDER_LARGE_IS_LOCAL=true
# is_local=true here is deliberate, not a copy-paste of the `local` block: it means "your own
# infrastructure, not a vendor" (ADR-003), which a GPU box you own satisfies just as much as the
# CPU Ollama box. With both providers is_local=true, `local_first` load-balances the two by
# latency/queue depth rather than always preferring `local` -- use `quality_first` if you want
# the GPU/vLLM tier preferred whenever it's healthy, or `balanced` for a blend of both.
# `http://vllm:8000/v1` assumes the compose `vllm` service on the same box/network. Pointing at
# a GPU host on a different machine you own (e.g. `http://gpu-host.internal:8000/v1`) needs no
# extra flag. AURA_ALLOW_REMOTE_INFERENCE is a separate, narrower gate: it only fires for a
# specific list of *rented*-compute hostnames (Hugging Face Spaces, Cloud Run, Fly.io, etc. --
# see aura_core/config/external_inference.py's REMOTE_INFERENCE_HOSTS), not for a machine you
# control just because it's remote.
# AURA_VLLM_MODEL and AURA_VLLM_GPU_MEMORY_UTILIZATION configure the `vllm` compose service
# itself (must match AURA_PROVIDER_LARGE_MODEL above):
#   AURA_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
#   AURA_VLLM_GPU_MEMORY_UTILIZATION=0.90
#
# This block previously showed a hosted-vendor provider. That was wrong twice over: it instructed
# the operator to add external inference, which the platform forbids, and that provider kind had
# already been removed, so following it produced a ConfigurationError at boot.

# To add a distributed failover provider that only takes traffic when `local` (Contabo Ollama) is
# unavailable, add a real vLLM server on a paid-tier Hugging Face Space GPU -- see
# docs/guides/split-inference-deployment.md §8 for the full walkthrough (creating the Space,
# uploading deploy/spaces/inference-vllm/, verifying it). `AURA_ALLOW_REMOTE_INFERENCE=true` is
# required because hf.space is a *gated*, not banned, host (aura_core/config/external_inference.py
# REMOTE_INFERENCE_HOSTS) -- a Space runs your own container/weights on rented compute, which is a
# legitimate but consequential choice (offline capability is lost; prompts/documents leave
# infrastructure you control) that must be opted into explicitly.
# AURA_ALLOW_REMOTE_INFERENCE=true
#
#   AURA_LLM_PROVIDERS=local,hfspace
#   AURA_PROVIDER_HFSPACE_KIND=openai_compatible
#   AURA_PROVIDER_HFSPACE_BASE_URL=https://<your-username>-aura-inference-vllm.hf.space/v1
#   AURA_PROVIDER_HFSPACE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
#   AURA_PROVIDER_HFSPACE_API_KEY_ENV=AURA_PROVIDER_HFSPACE_API_KEY
#   AURA_PROVIDER_HFSPACE_IS_LOCAL=false
#   AURA_PROVIDER_HFSPACE_QUALITY_TIER=2
#   AURA_PROVIDER_HFSPACE_CONTEXT_WINDOW=8192
#   AURA_PROVIDER_HFSPACE_TIMEOUT_S=45
#   # The liveness probe's own deadline, separate from the request timeout above. A Space
#   # scales to zero and takes minutes to wake; at the 5s default the probe times out
#   # identically whether the Space is seconds from ready or permanently dead, so
#   # /health/ready cannot tell "asleep" from "broken" (EV-28).
#   AURA_PROVIDER_HFSPACE_HEALTH_TIMEOUT_S=30
#   AURA_PROVIDER_HFSPACE_MAX_CONCURRENCY=8
#
#   # The key itself, matching the Space's VLLM_API_KEY secret. Never in the provider block.
#   AURA_PROVIDER_HFSPACE_API_KEY=<same value as the Space's VLLM_API_KEY secret>
#
# is_local=false here is deliberate and the opposite of the `large` example above: it means "rented
# compute we don't own," which keeps `local_first` always ranking this behind `local` while
# Contabo/Ollama's circuit is closed -- it is reached only on failover (ADR-003's per-provider
# circuit breaker), never as a preferred path. TIMEOUT_S=45 is deliberately much shorter than a
# CPU Space's 300s: once warm, GPU vLLM answers in a few seconds, and a long timeout here would
# only make a genuinely dead Space hang the failover path. MAX_CONCURRENCY=8 reflects GPU batching
# versus a CPU Space's 2. If the Space's own storage isn't persistent, weights re-download on every
# cold start after it sleeps -- prefer an always-on GPU flavor for this node specifically, since an
# unreliable failover defeats the point.

# --- Hosted open-weight providers (opt-in; ADR-030) --------------------------------------
# Free hosted APIs serving open-weight models (Groq, Cloudflare Workers AI, OpenRouter's
# `:free` models, ...) as primary, with `local` kept as the last-resort fallback. Read
# docs/roadmaps/AURA_FREE_HOSTED_INFERENCE_PLAN.md first, for the free quotas (about 180
# turns/day in total) and for what leaving your infrastructure means.
#
# What stays local regardless: only INTERNAL content -- the user's message and an untainted
# conversation -- may reach a hosted slot. Documents, memory, goals, tool output, Engineer
# workspaces and caller evidence are SENSITIVE and are served by `local`, unless you raise a
# slot's AURA_PROVIDER_HOSTEDn_MAX_DATA_CLASSIFICATION (ADR-030 §8).
#
# Three slots are pre-wired in both compose files (x-hosted-providers); each is inert until
# listed in AURA_LLM_PROVIDERS. Keys never go here. Overwrite the placeholder secret file
# bootstrap-secrets.sh created:
#   printf '%s' "$YOUR_KEY" > deploy/secrets/hosted1_api_key
#
# AURA_ALLOW_HOSTED_INFERENCE=true
# AURA_LLM_PROVIDERS=hosted1,hosted2,hosted3,local
# # And change the AURA_LLM_ROUTING_POLICY line above to quality_first: hosted slots default to
# # quality tier 3 and `local` is tier 1, so hosted is tried first and `local` catches the rest.
#
# # Slot 1 -- Groq, gpt-oss-120b. Published free limits per model: 30 RPM, 1000 RPD, 8000 TPM,
# # 200000 TPD; re-check them in the Groq console, since they change.
# AURA_PROVIDER_HOSTED1_BASE_URL=https://api.groq.com/openai/v1
# AURA_PROVIDER_HOSTED1_MODEL=openai/gpt-oss-120b
# AURA_PROVIDER_HOSTED1_CONTEXT_WINDOW=32768
# AURA_PROVIDER_HOSTED1_RPM=30
# AURA_PROVIDER_HOSTED1_RPD=1000
# AURA_PROVIDER_HOSTED1_TPM=8000
# AURA_PROVIDER_HOSTED1_TPD=200000
# # Phase 3 truthfulness. TOKENS_PER_SECOND lets the planner use 1200 output tokens instead of
# # 700 on a provider fast enough to finish them; leave it unset for anything CPU-bound. gpt-oss
# # is a reasoning model: reasoning_effort=low keeps hidden reasoning from eating max_tokens and
# # the 8000 TPM. Single quotes keep the JSON intact. SUPPORTS_JSON_MODE=true only if the model
# # honours response_format json_schema (Groq's gpt-oss does); otherwise structured-output turns
# # go to `local`.
# AURA_PROVIDER_HOSTED1_TOKENS_PER_SECOND=200
# AURA_PROVIDER_HOSTED1_EXTRA_BODY='{"reasoning_effort": "low"}'
# AURA_PROVIDER_HOSTED1_SUPPORTS_JSON_MODE=true
#
# # Slot 2 -- a second Groq model. Quotas are per model, so this doubles the daily budget on
# # the same key (write the same key to deploy/secrets/hosted2_api_key).
# AURA_PROVIDER_HOSTED2_BASE_URL=https://api.groq.com/openai/v1
# AURA_PROVIDER_HOSTED2_MODEL=qwen/qwen3.8-27b
# AURA_PROVIDER_HOSTED2_RPM=30
# AURA_PROVIDER_HOSTED2_RPD=1000
# AURA_PROVIDER_HOSTED2_TPM=8000
# AURA_PROVIDER_HOSTED2_TPD=200000
# AURA_PROVIDER_HOSTED2_TOKENS_PER_SECOND=200
#
# # Slot 3 -- Cloudflare Workers AI (10,000 neurons/day free). The key is an API token with
# # Account > Workers AI > Read. Its quota is counted in neurons, not tokens, so it declares no
# # token limits and relies on the 429 cooldown instead. Verify the health path on first boot
# # (/health/ready). If /models is not served under /ai/v1, set HEALTH_PATH to one that is,
# # because a health probe must never be a completion.
# AURA_PROVIDER_HOSTED3_BASE_URL=https://api.cloudflare.com/client/v4/accounts/<ACCOUNT_ID>/ai/v1
# AURA_PROVIDER_HOSTED3_MODEL=@cf/openai/gpt-oss-20b
# AURA_PROVIDER_HOSTED3_QUALITY_TIER=2
#
# # Alternative slot 3 -- OpenRouter. Put the key in deploy/secrets/hosted3_api_key, never here.
# # Only open-weight model IDs boot: OpenRouter's closed models (openai/gpt-4o, anthropic/...,
# # google/gemini-...) are refused whatever the flags say.
# #
# # Free models (`:free`): 20 RPM and 50 requests/day per account (1000/day once the account has
# # bought at least $10 of credit). As of 2026-10-28 every free open-weight endpoint there runs
# # under OpenRouter's "free model training" data policy: the upstream may train on, or keep, the
# # prompts it receives. Boot refuses a `:free` model unless ALLOW_PROMPT_TRAINING=true says you
# # accept that (ADR-030 §3). Such a slot is still capped at `internal`: only the user's message
# # and an untainted conversation are sent; documents, memory, goals, tool output and Engineer
# # workspaces stay on `local`, and a slot that may train cannot be raised to `sensitive`.
# # The account's privacy setting must also allow free-model training, or OpenRouter answers 404.
# # Nemotron 3 reasons by default; switching that off keeps short answers from running out of
# # budget mid-thought (and AURA drops reasoning an upstream copies into the answer if it does).
# # AURA_PROVIDER_HOSTED3_BASE_URL=https://openrouter.ai/api/v1
# # AURA_PROVIDER_HOSTED3_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free
# # AURA_PROVIDER_HOSTED3_ALLOW_PROMPT_TRAINING=true
# # AURA_PROVIDER_HOSTED3_EXTRA_BODY='{"reasoning": {"enabled": false}}'
# # AURA_PROVIDER_HOSTED3_CONTEXT_WINDOW=32768
# # AURA_PROVIDER_HOSTED3_RPM=20
# # AURA_PROVIDER_HOSTED3_RPD=50
# #
# # To keep prompts out of training instead, drop `:free`, buy credit, and pin OpenRouter to
# # providers that neither train on nor retain prompts (no ALLOW_PROMPT_TRAINING needed):
# # AURA_PROVIDER_HOSTED3_MODEL=nvidia/nemotron-3-ultra-550b-a55b
# # AURA_PROVIDER_HOSTED3_EXTRA_BODY='{"provider": {"data_collection": "deny"}, "reasoning": {"enabled": false}}'
#
# Rollback is AURA_LLM_PROVIDERS=local (or AURA_ALLOW_HOSTED_INFERENCE=false, which makes boot
# refuse the hosted slots loudly). No data migration and no client release are involved.

# --- Claude for complex requests (opt-in; ADR-033) ---------------------------------------
# Anthropic's Claude as the provider for the most demanding turns, with everything else staying
# where it is. Two independent switches, both off by default:
#
#   AURA_ALLOW_CLAUDE_INFERENCE=true    lets a provider of KIND=claude boot at all. Without it the
#                                       gateway refuses to start with that provider listed.
#                                       AURA_ALLOW_HOSTED_INFERENCE does not cover it.
#   AURA_LLM_COMPLEXITY_ROUTING=true    scores each interactive message (aura_core/llm/complexity.py)
#                                       and sends the ones at or above the threshold to the
#                                       `reasoning` pool. Everyday turns never reach that pool.
#
# Claude still gets only INTERNAL content by default: a complex turn that pulls in documents,
# memory, tool output or an Engineer workspace is SENSITIVE and is answered by `local`. If Claude
# is down, rate-limited or out of budget, complex turns fall back to `local` too.
#
# Use any free hosted slot. The key comes from the Claude Console (Settings > API keys) and goes
# in that slot's secret file, never here:
#   printf '%s' "$YOUR_CLAUDE_KEY" > deploy/secrets/hosted2_api_key
#
# AURA_ALLOW_CLAUDE_INFERENCE=true
# AURA_LLM_COMPLEXITY_ROUTING=true
# AURA_LLM_COMPLEXITY_THRESHOLD=0.5
# AURA_LLM_PROVIDERS=local,hosted2
# AURA_PROVIDER_HOSTED2_KIND=claude
# # No BASE_URL: the claude kind always uses the SDK's own endpoint, and refuses one if set.
# AURA_PROVIDER_HOSTED2_MODEL=claude-opus-5-5
# AURA_PROVIDER_HOSTED2_POOLS=reasoning
# AURA_PROVIDER_HOSTED2_SUPPORTS_REASONING=true
# AURA_PROVIDER_HOSTED2_QUALITY_TIER=3
# AURA_PROVIDER_HOSTED2_CONTEXT_WINDOW=200000
# # Thinking tokens count against this cap; the adapter adds 8000 tokens of thinking headroom
# # to every request's answer budget, up to this value.
# AURA_PROVIDER_HOSTED2_MAX_OUTPUT_TOKENS=32000
# AURA_PROVIDER_HOSTED2_TIMEOUT_S=300
# AURA_PROVIDER_HOSTED2_TOKENS_PER_SECOND=60
# # USD per 1k tokens, so the router and cost telemetry see the real spend ($4 / $20 per MTok).
# AURA_PROVIDER_HOSTED2_COST_INPUT=0.004
# AURA_PROVIDER_HOSTED2_COST_OUTPUT=0.02
# # Optional: effort (default high) and the refusal fallback (default on, `null` turns it off).
# # AURA_PROVIDER_HOSTED2_EXTRA_BODY='{"output_config": {"effort": "xhigh"}}'

# --- Embeddings --------------------------------------------------------------------------
# Changing either of these changes the index identity and forces a rebuild, by design (ADR-007).
AURA_EMBEDDING_PROVIDER=sentence-transformers
AURA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AURA_EMBEDDING_DIMENSION=384

# Hugging Face access token, read directly from the environment by huggingface_hub /
# sentence-transformers (not an AURA_* setting -- no aura_core code reads this name).
# Optional: weight downloads work unauthenticated, just subject to the Hub's lower anonymous
# rate limit. Set a real token (read-only access is enough) to avoid that on every cold model
# load. Deliberately not in BANNED_CREDENTIAL_NAMES (aura_core/config/external_inference.py) --
# it authenticates permitted model-weight downloads, not a paid inference API (SEC-01).
HF_TOKEN=

# --- Device attestation ------------------------------------------------------------------
# Production must refuse mock attestation (AuraSettings.validate fails closed).
# Debug Flutter APKs cannot mint real Play Integrity / App Attest tokens; point
# those builds at a *local* compose stack with ALLOW_MOCK_ATTESTATION=true, not
# this production host. Production compose defaults this to false.
ALLOW_MOCK_ATTESTATION=false
# Must stay false in staging/production. AuraSettings and legacy Settings refuse
# to boot if DEBUG_MODE or AURA_DEBUG is true in those environments.
DEBUG_MODE=false
# Apple Developer Team ID (10 characters). Required for iOS App Attest verify.
# App ID hashed into authData is APPLE_TEAM_ID.com.auraai.auraClient
APPLE_TEAM_ID=

# Router semaphore must match OLLAMA_NUM_PARALLEL=1 on this CPU box.
AURA_PROVIDER_LOCAL_MAX_CONCURRENCY=1

# --- Encryption at rest (memories + personal-OS records) --------------------------------
# Server-side application-level encryption of aura_memories.content and
# aura_personal_os_records.fields (aura_core/adapters/field_crypto.py; ADR-004 "Encryption at
# rest"). NOT end-to-end encryption: the gateway/workers hold the key and read the data.
# REQUIRED in staging/production -- AuraSettings.validate() refuses to start without it.
# Do NOT set it here: it is a file-backed secret, deploy/secrets/data_encryption_keys, mounted
# as AURA_DATA_ENCRYPTION_KEYS_FILE (docker-compose.prod.yml `secrets:`). bootstrap-secrets.sh
# (run by vps-update.sh on every deploy) generates it if missing. To create one by hand:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())" \
#     > deploy/secrets/data_encryption_keys && chmod 600 deploy/secrets/data_encryption_keys
# Rotation: put the NEW key on the first line, keep the old one below it, restart, then run
#   docker compose -p aura -f deploy/docker-compose.prod.yml exec gateway \
#     python scripts/reencrypt_fields.py            # add --dry-run first to preview
# and remove the old line only once the script reports old_key=0 / failed=0. The same script
# seals rows written before a key existed (they stay readable meanwhile). Back this key up
# separately from the database backups -- a dump is unreadable without it.
# AURA_DATA_ENCRYPTION_KEYS=<only for running outside compose; newest key first, comma-separated>

# --- Admission control (roadmap P2.4, aura_core/llm/admission.py) -------------------------
# Requests that find the model busy wait in AURA's bounded priority queue (interactive/voice
# first, then Engineer, insights, indexing, training) and are refused with 503 + Retry-After
# after the timeout -- rather than piling up inside Ollama until the provider timeout cancels
# them. Per *process*: the effective cap on Ollama is MAX_CONCURRENCY x AURA_WORKERS (+ Celery
# workers). Code defaults (unset) are the old behaviour: unbounded queue, no timeout, no quota.
AURA_LLM_ADMISSION_MAX_QUEUE=4
AURA_LLM_ADMISSION_QUEUE_TIMEOUT_S=90
# Background workers wait longer: nobody is watching a spinner.
AURA_LLM_WORKER_ADMISSION_QUEUE_TIMEOUT_S=300
# Concurrent generations per user (a second request from the same user queues; beyond that 429).
AURA_LLM_USER_MAX_CONCURRENT_GENERATIONS=2
# Per-provider overrides: AURA_PROVIDER_<NAME>_MAX_QUEUE, AURA_PROVIDER_<NAME>_QUEUE_TIMEOUT_S.
# Per-turn latency bounds (PP-06/PP-07). 0 = off (the code default): each attempt is bounded only
# by its own timeout, and a stream only per chunk. The budget covers all of one chat/voice turn's
# generations, fallbacks included; Engineer turns never get one. Sizing: docs/deployment/control-plane.md.
# AURA_LLM_TURN_GENERATION_BUDGET_S=0
# AURA_LLM_STREAM_MAX_S=0
# Model-level metadata (P2.3), all optional: AURA_PROVIDER_<NAME>_{POOLS,SPEED_TIER,GPU_COST,
# MEMORY_COST,MODALITIES,SUPPORTS_REASONING,LANGUAGES,MODEL_REVISION,CAPACITY_GROUP}.
# Quotas (ADR-030 Phase 2, aura_core/llm/quota.py), all optional, 0 = undeclared:
# AURA_PROVIDER_<NAME>_{RPM,RPD,TPM,TPD} -- a provider's published requests/tokens per
# minute/day. Declared, the router skips it *before* sending once a budget would be exceeded.
# Any provider answering 429 is benched until the reset its headers name, else for
# AURA_LLM_RATE_LIMIT_COOLDOWN_S (default 30); a 429 never opens the circuit breaker.
# AURA_PROVIDER_<NAME>_HEALTH_PATH (default /models) moves the liveness probe for a hosted API.
# Data sensitivity (ADR-030 Phase 4): AURA_PROVIDER_<NAME>_MAX_DATA_CLASSIFICATION =
# public|internal|sensitive is the most private content a provider may receive. Default:
# internal for a hosted open-weight API (documents, memory, goals, tool output and Engineer
# workspaces stay local), sensitive (everything) for anything self-hosted.

# --- GPU model pools (opt-in; BUILT, NOT PROVEN) -----------------------------------------
# Used only with `-f deploy/docker-compose.gpu.yml --profile gpu`. Revisions are REQUIRED there
# (compose refuses to render without them) -- pin each to a Hugging Face commit SHA:
#   AURA_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
#   AURA_VLLM_MODEL_REVISION=<commit sha>
#   AURA_VLLM_CODER_MODEL=Qwen/Qwen2.5-Coder-14B-Instruct-AWQ
#   AURA_VLLM_CODER_REVISION=<commit sha>
#   AURA_VLLM_EMBED_MODEL=BAAI/bge-m3
#   AURA_VLLM_EMBED_REVISION=<commit sha>
# See docs/guides/gpu-hybrid-setup.md §6 for the rest (GPU assignment, --max-num-seqs sizing).

# --- Model lifecycle ---------------------------------------------------------------------
# Empty means model pulls are disabled. Fails closed: weights are executable artefacts
# fetched from a third party (SEC-01). Include both the CPU-default 3B and the
# previously installed 7B so either tag can be pulled / loaded without a compose edit.
AURA_MODEL_ALLOWLIST=qwen2.5:3b-instruct-q4_K_M,qwen2.5:7b-instruct-q4_K_M

# --- Engineer agent: GitHub ---------------------------------------------------------------
# Neither path below does anything by itself: a user also needs the "engineer_agent"
# capability (AURA_ENGINEER_AGENT_ROLES above) before either of these tools reaches them at
# all -- that capability is what unlocks the `engineer` persona, not these two flags.
# Both paths below are off by default and independent of each other and of
# AURA_SANDBOX_ENABLED (the engineer agent's filesystem/command/git tools) -- enabling one does
# not enable the others.
#
# --- Engineer agent: persistent workspaces (ADR-013) ---------------------------------------
# Turning this on gives the engineer agent a real, durable Docker workspace per (user,
# repository): a genuine git checkout with history that survives between turns and is deleted
# after three days without activity. Off by default, and it needs the `sandbox` compose profile.
# Set BOTH of these so a normal `vps-update.sh` / `docker compose up -d` brings the proxy and
# socket-proxy services up; `AURA_SANDBOX_ENABLED` alone only flips the gateway flag:
#   COMPOSE_PROFILES=sandbox
#   AURA_SANDBOX_ENABLED=true
# Or one-shot: docker compose -f deploy/docker-compose.prod.yml --profile sandbox up -d
#
# AURA_SANDBOX_ENABLED=true
# COMPOSE_PROFILES=sandbox
# The workspace root. This is a HOST path, and the compose file bind-mounts it into the gateway
# at the *same* path on purpose -- the Docker daemon resolves bind sources on the host, so a path
# that existed only inside the gateway would silently be a different, empty directory. Change
# both sides together or not at all.
# AURA_SANDBOX_HOST_ROOT=/opt/aura-stack/deploy/sandboxes
#
# Capacity. A workspace is *stopped* between turns rather than deleted, and a stopped container
# holds no memory -- so peak RAM is MAX_RUNNING * MEMORY_LIMIT no matter how many workspaces
# exist. The defaults assume the documented 24 GB host; on 16 GB, where this competes with
# Ollama for the same pages, use MAX_RUNNING=1 and MAX_WORKSPACES=2.
# AURA_SANDBOX_MAX_RUNNING=2
# AURA_SANDBOX_MAX_WORKSPACES=4
# AURA_SANDBOX_MEMORY_LIMIT=512m
# AURA_SANDBOX_CPU_LIMIT=1.0
# AURA_SANDBOX_WORKSPACE_DISK_QUOTA_MB=2048
#
# Refuse to start a workspace when the host has less than this much memory free. A refusal the
# agent can report beats an OOM kill choosing a victim -- the largest process here is the model
# server, so "start it and see" means someone else's chat dies for a build.
# AURA_SANDBOX_MIN_FREE_MEMORY_MB=1024
#
# Expiry, in hours since a workspace was last used (not since it was created, so one in daily
# use is never reaped). The reaper runs every 30 minutes; see celery_app.py's beat schedule.
# AURA_SANDBOX_WORKSPACE_TTL_HOURS=72
# Idle seconds before a still-running workspace is stopped to return its memory.
# AURA_SANDBOX_HOT_IDLE_S=900
#
# Egress. `sandbox_egress` is an internal network, so the tinyproxy sidecar is the only way out
# and it forwards solely to the hosts in deploy/sandbox/filter (GitHub, PyPI, npm). Edit that
# file to allow more -- every entry is somewhere a compromised workspace could send a checkout.
# AURA_SANDBOX_PROXY_URL=http://sandbox-proxy:8888
#
# Where git runs. Default (false) runs it in the gateway, so a private clone's token never
# enters a container executing model-chosen commands. Setting this true moves git inside the
# workspace and accepts that a command there can read the credential.
# AURA_SANDBOX_IN_CONTAINER_GIT=false

# Path 1 -- one shared admin token for the whole deployment. Every user's engineer-agent GitHub
# tool calls run as this one PAT.
# AURA_GITHUB_ENABLED=true
# AURA_GITHUB_DEFAULT_OWNER=your-org
# AURA_GITHUB_DEFAULT_REPO=your-repo
# Restricts the token to exactly these repos, regardless of what a model's tool arguments claim.
# AURA_GITHUB_ALLOWED_REPOS=your-org/your-repo
# The PAT itself (AURA_GITHUB_TOKEN) has no Docker-secret-file wiring in this compose file today
# -- unlike every secret below, it has to be passed as a plain environment value to the gateway
# service, e.g. in deploy/.env, which means it is visible to `docker inspect`/process listings
# (SEC-08 does not yet cover it).
#
# Path 2 -- each user connects their own GitHub account (a GitHub App's OAuth flow), so tool
# calls run against exactly the repos that user granted, not a shared token. Requires a GitHub
# App registered at github.com (Settings -> Developer settings -> GitHub Apps) with Contents,
# Pull requests, and Metadata permissions, and a callback URL matching
# AURA_GITHUB_OAUTH_CALLBACK_URL exactly.
# AURA_GITHUB_OAUTH_ENABLED=true  (vps-update.sh sets this itself once the two lines below
#                                  and the real client secret file are in place)
# AURA_GITHUB_OAUTH_CLIENT_ID=<the App's Client ID>
# AURA_GITHUB_OAUTH_CALLBACK_URL=https://aureon-ai.tech/api/v3/integrations/github/callback
# The client secret and the token-encryption key are both file-backed secrets, not env vars here
# -- see docker-compose.prod.yml's `secrets:` block. bootstrap-secrets.sh generates
# deploy/secrets/secrets_encryption_key automatically; deploy/secrets/github_oauth_client_secret
# needs the real value from the GitHub App's settings page pasted in by hand before this is true:
#   printf '%s' "$CLIENT_SECRET" > deploy/secrets/github_oauth_client_secret

# --- Backups ---------------------------------------------------------------------------
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14
# Offsite copy after a successful local cycle. Leave BACKUP_S3_URI empty to skip.
# Retention offsite should be >= local. Credentials: deploy/secrets/rclone.conf
# or deploy/secrets/backup_s3_access_key + backup_s3_secret_key (never commit them).
# BACKUP_S3_URI=s3:my-bucket/aura
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_PROVIDER=Other
# BACKUP_OFFSITE_RETENTION_DAYS=14

# --- Backup encryption, integrity & retention (P1.3) -----------------------------------
# Every backup set is age-encrypted before it is written to BACKUP_PATH or shipped offsite.
# ON by default and FAILS CLOSED: with no recipient configured the backup cycle refuses to run
# (alert AuraBackupMisconfigured) instead of writing plaintext. Configure a recipient BEFORE
# deploying this change, or nightly backups stop.
#
# Recipient = the age PUBLIC key ("age1..."). The matching private key must NOT be on this host:
# generate it offline (age-keygen -o aura-backup.agekey), keep it offline/in a password manager,
# and put only the public key here or in deploy/secrets/backup_age_recipients.txt (one per line;
# list two keys while rotating). Procedure: docs/guides/maintenance-guide.md "Backup encryption keys".
BACKUP_ENCRYPTION=age
# BACKUP_AGE_RECIPIENT=age1...
# BACKUP_ENCRYPTION=none   # explicit plaintext opt-out: local only, never shipped offsite
#
# Grandfather-father-son retention of backup sets. Daily defaults to BACKUP_RETENTION_DAYS.
# Nothing is pruned (locally or offsite) unless the newest set verified.
# BACKUP_KEEP_DAILY=14
# BACKUP_KEEP_WEEKLY=4
# BACKUP_KEEP_MONTHLY=6
# Offsite counts default to the local ones (daily: BACKUP_OFFSITE_RETENTION_DAYS if set).
# BACKUP_OFFSITE_KEEP_DAILY=14
# BACKUP_OFFSITE_KEEP_WEEKLY=4
# BACKUP_OFFSITE_KEEP_MONTHLY=12
# Remote verification after upload: check (size + common hash, default) or download (re-reads
# every object; slower, but independent of the backend exposing hashes).
# BACKUP_OFFSITE_VERIFY=check
# --- end backup encryption block --------------------------------------------------------

# --- Voice (TTS + Phase H live duplex) -------------------------------------------------
# Primary speaker is Piper (baked under /opt/piper/voices/ at image build).
# espeak-ng is last-resort only when a language's ONNX is missing.
# AURA_VOICE_PIPER_EN_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx
# AURA_VOICE_PIPER_AR_MODEL=/opt/piper/voices/ar_JO-kareem-medium.onnx
# AURA_VOICE_PIPER_LENGTH_SCALE=1.08
# Fallback knobs (formant speech). espeak-ng stock is 175 wpm with no word gap.
# AURA_VOICE_TTS_VOICE=en-us
# AURA_VOICE_TTS_RATE_WPM=142
# AURA_VOICE_TTS_WORD_GAP=6
# AURA_VOICE_TTS_PITCH=45
# AURA_VOICE_TTS_AMPLITUDE=88
# AURA_VOICE_TTS_AR_VOICE=ar
# AURA_VOICE_TTS_AR_RATE_WPM=130
# Live WebSocket (/api/v3/voice/live). docker-compose.prod.yml defaults this to true;
# set false to refuse sessions (health/ready reports voice.live=false).
# AURA_VOICE_LIVE_ENABLED=true
# AURA_VOICE_LIVE_MAX_SESSIONS=8

# --- Image understanding (ADR-031) --------------------------------------------------------
# Off by default. Needs a provider that declares the image modality, e.g. a vLLM pool
# serving Qwen/Qwen3-VL-8B-Instruct with AURA_PROVIDER_VISION_MODALITIES=text,image and
# AURA_PROVIDER_VISION_POOLS=vision; with none, image turns use OCR text if OCR is on, else
# 503. Images are never sent to a hosted third-party slot and never stored.
# AURA_VISION_ENABLED=false
# AURA_VISION_MAX_IMAGES=4

# --- Alertmanager (AURA-015) -----------------------------------------------------------
# Incoming webhook (Discord/Slack/generic). Leave empty to keep receivers silent —
# do not use a placeholder URL that 404s. Never commit a live URL.
# Critical alerts (AuraGatewayDown, AuraInsecureModeActive, AuraAllProvidersUnhealthy)
# use ALERTMANAGER_CRITICAL_WEBHOOK_URL if set, otherwise this same URL.
ALERTMANAGER_WEBHOOK_URL=
# ALERTMANAGER_CRITICAL_WEBHOOK_URL=
# Optional: first non-comment line of this gitignored file is used if the env var is empty.
#   printf '%s\n' "$YOUR_DISCORD_OR_SLACK_WEBHOOK" > deploy/secrets/alertmanager_webhook_url
# ALERTMANAGER_WEBHOOK_URL_FILE=/run/secrets/alertmanager_webhook_url
# Optional SMTP (all three required to enable email):
# ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
# ALERTMANAGER_SMTP_FROM=aura-alerts@example.com
# ALERTMANAGER_SMTP_TO=ops@example.com
# ALERTMANAGER_SMTP_AUTH_USERNAME=
# ALERTMANAGER_SMTP_AUTH_PASSWORD=
# ALERTMANAGER_SMTP_REQUIRE_TLS=true

# --- Track AP: Adaptive AI Platform connectors (ADR-021) ---------------------------------------
# Lets a Super Admin register connectors to an existing system (PostgreSQL in AP2) under
# /api/v3/admin/connectors. Off by default; with it off those routes answer 503. Connector
# credentials are encrypted with deploy/secrets/secrets_encryption_key (AURA_SECRETS_ENCRYPTION_KEY);
# without that key a connector that needs a password is refused, never stored in the clear.
# Use a read-only database role: activation is refused if the role can write.
# AURA_ADAPTATION_ENABLED=false
# Project Twin labeling model (AP4): optional; without it twins keep humanised identifiers.
# AURA_ADAPTATION_LABELER_ENABLED=false
# Blueprint runtime (AP7). Roles allowed to use agents/tools compiled from a deployed blueprint
# (empty: nobody).
# AURA_PROJECT_DATA_ROLES=
# Evaluation gate (AP8): every blueprint version is evaluated against its connectors before it can
# be approved. enforce = a failing version stays proposed; advisory = it may proceed, with the
# failure recorded on the version and its approval request (the roadmap's rollback lever).
# AURA_ADAPTATION_GATE_MODE=enforce
# Share of each gating suite's cases that must actually run (the rest had no reachable connector).
# AURA_ADAPTATION_GATE_MIN_COVERAGE=0.8
# Files connectors (AP10): directory, inside the gateway container, under which a `files`
# connector's endpoint (a sub-directory) holds CSV/JSON exports. Empty = the `files` kind is off.
# Mount a read-only volume there (neither compose file mounts one by default).
# AURA_ADAPTATION_FILES_ROOT=
# Directory under which `git` connectors read repository checkouts (AP10): each connector's
# endpoint is a sub-directory holding a clone the operator keeps current. AURA reads its SQL, ORM
# models, migrations, routes and OpenAPI files as text and never runs anything from it. Empty =
# the `git` kind is off. Mount it read-only (neither compose file mounts one by default).
# AURA_ADAPTATION_GIT_ROOT=
# AURA_ADAPTATION_TOOL_GRACE_S=300
# AURA_ADAPTATION_SYNC_S=15
