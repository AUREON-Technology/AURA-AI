# Copy to deploy/.env and adjust. Secrets live in deploy/secrets/ as files, never here.

# Hostname TLS is issued for, nginx server_name, AND the Flutter client BACKEND_URL host.
# No owned domain: use the VPS nip.io name so HTTPS can still match a certificate SAN.
# Do not use a bare IP — Android/iOS reject that. Rebuild the client after any change:
# ./deploy_client.sh (or deploy_client.ps1).
AURA_DOMAIN=169.58.188.43.nip.io
# Dev subdomain routed by prod nginx to the aura-dev compose stack (parallel Postgres/Qdrant).
AURA_DEV_DOMAIN=dev.169.58.188.43.nip.io
AURA_WORKERS=4
AURA_LOG_LEVEL=INFO

# Deployment environment (aura_core/config/settings.py's Environment enum).
# Valid values: local | development | staging | production.
# docker-compose.prod.yml defaults this to `production` when unset, but an
# explicit wrong value here (e.g. copied from a dev .env) silently overrides
# that default. staging/production are the only values that enable
# is_production_like, which refuses to boot if allow_mock_auth or
# allow_mock_attestation are true (settings.py's validate()) -- so a
# mislabeled environment disables that safety check with no visible error.
# MUST be `production` on the real VPS.
AURA_ENVIRONMENT=production

# Browser origins allowed to call the API (Flutter web). Native apps ignore CORS.
# Leave unset so compose defaults to localhost + Flutter web ports + https://$AURA_DOMAIN.
# Uncomment and extend only if the web bundle is hosted on another origin (Vercel/Netlify).
# ALLOWED_ORIGINS=http://localhost,http://127.0.0.1,http://localhost:8080,http://127.0.0.1:8080,https://169.58.188.43.nip.io

# Google Identity Services client id baked into the /console image at build time.
# Defaults to the same id as aura_backend.config.Settings.google_client_id.
# GOOGLE_CLIENT_ID=87789110323-5picq501c0834g6g0amjqqpk628jaoh2.apps.googleusercontent.com

# Desktop app ("aura_client" on Linux/Windows) OAuth login audience (ADR-011 Unit 7).
# Defaults to aura_backend.config.Settings.google_desktop_client_id, a separate "Desktop app"-
# type OAuth client registered in the same Google Cloud project. Uncomment only to point at a
# different registered Desktop client than the one hardcoded there.
# AURA_GOOGLE_DESKTOP_CLIENT_ID=87789110323-pprobmjkf4f16rem4kacr2nqgi9ql1i0.apps.googleusercontent.com

# Operator allowlists (comma-separated). Must be listed on the gateway service
# in docker-compose.prod.yml or they never reach os.getenv in services.rbac.
# SUPERADMIN_EMAILS is the only list that can mint SuperAdmin. Console login
# requires Developer+. A User is anyone not on these lists (Flutter client only).
SUPERADMIN_EMAILS=
ADMIN_EMAILS=
DEVELOPER_EMAILS=

# Which of the roles above get the "engineer_agent" capability -- required to use the
# `engineer` persona and any of its tools (sandboxed filesystem/command/git, GitHub
# read+write; see the "Engineer agent: GitHub" section further down for the GitHub half of
# this). Comma-separated role names (User, Developer, Admin, SuperAdmin). Empty means nobody
# gets it -- unlike the email lists above, this is not a role assignment but a capability
# grant, and the engineer persona can run shell commands and open PRs on the caller's behalf,
# so it is opt-in per deployment rather than defaulting to Admin/SuperAdmin.
# AURA_ENGINEER_AGENT_ROLES=Developer,Admin,SuperAdmin
# On a host deployed by deploy/scripts/vps-update.sh, this key is set to Admin,SuperAdmin
# when deploy/.env either has no line for it or has one with an empty value -- both grant the
# capability to nobody, and deploy/.env is gitignored, so no pull request can reach it. Give it
# a non-empty value here and the script prints that value and leaves it alone.

# --- LLM providers -----------------------------------------------------------------------
# Comma-separated provider names; each is configured by AURA_PROVIDER_<NAME>_* variables.
# The compose file pre-configures `local` against the bundled Ollama container.
AURA_LLM_PROVIDERS=local
# Default is the 3B Q4 quant: this VPS is CPU-only (8 cores, no NVIDIA). A 7B Q4 with
# OLLAMA_NUM_PARALLEL=2 was starving the box and timing out chat. Keep the 7B weights
# installed if already pulled; switch AURA_LOCAL_MODEL (and AURA_PROVIDER_LOCAL_MODEL)
# back to the 7B tag when a GPU host is available. Compose prefers
# AURA_PROVIDER_LOCAL_MODEL, then AURA_LOCAL_MODEL.
AURA_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_LLM_ROUTING_POLICY=local_first
# Router deadline and the local provider HTTP client. CPU generation of even 3B-Q4
# routinely exceeds the 60s library default; nginx SSE already allows 300s.
AURA_LLM_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_TIMEOUT_S=180

# To add a second provider for quality-sensitive turns, extend the list. It must be another
# endpoint you host: `kind` accepts only `openai_compatible`, `ollama` and `echo`, and a
# `base_url` pointing at a hosted inference API is rejected at construction. A larger model on
# a GPU box is the intended use -- see docs/reports/OLLAMA_VLLM_COMPARISON.md §4 (Option B)
# and docs/guides/gpu-hybrid-setup.md for the full walkthrough, including the optional `vllm`
# compose service (bring up with `--profile gpu`) this block is meant to pair with.
#   AURA_LLM_PROVIDERS=local,large
#   AURA_PROVIDER_LARGE_KIND=openai_compatible
#   AURA_PROVIDER_LARGE_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
#   AURA_PROVIDER_LARGE_BASE_URL=http://vllm:8000/v1
#   AURA_PROVIDER_LARGE_QUALITY_TIER=3
#   AURA_PROVIDER_LARGE_TIMEOUT_S=180
#   AURA_PROVIDER_LARGE_MAX_CONCURRENCY=4
#   AURA_PROVIDER_LARGE_IS_LOCAL=true
# is_local=true here is deliberate, not a copy-paste of the `local` block: it means "your own
# infrastructure, not a vendor" (ADR-003), which a GPU box you own satisfies just as much as the
# CPU Ollama box. With both providers is_local=true, `local_first` load-balances the two by
# latency/queue depth rather than always preferring `local` -- use `quality_first` if you want
# the GPU/vLLM tier preferred whenever it's healthy, or `balanced` for a blend of both.
# `http://vllm:8000/v1` assumes the compose `vllm` service on the same box/network. Pointing at
# a GPU host on a different machine you own (e.g. `http://gpu-host.internal:8000/v1`) needs no
# extra flag. AURA_ALLOW_REMOTE_INFERENCE is a separate, narrower gate: it only fires for a
# specific list of *rented*-compute hostnames (Hugging Face Spaces, Cloud Run, Fly.io, etc. --
# see aura_core/config/external_inference.py's REMOTE_INFERENCE_HOSTS), not for a machine you
# control just because it's remote.
# AURA_VLLM_MODEL and AURA_VLLM_GPU_MEMORY_UTILIZATION configure the `vllm` compose service
# itself (must match AURA_PROVIDER_LARGE_MODEL above):
#   AURA_VLLM_MODEL=Qwen/Qwen2.5-32B-Instruct-AWQ
#   AURA_VLLM_GPU_MEMORY_UTILIZATION=0.90
#
# This block previously showed a hosted-vendor provider. That was wrong twice over: it instructed
# the operator to add external inference, which the platform forbids, and that provider kind had
# already been removed, so following it produced a ConfigurationError at boot.

# To add a distributed failover provider that only takes traffic when `local` (Contabo Ollama) is
# unavailable, add a real vLLM server on a paid-tier Hugging Face Space GPU -- see
# docs/guides/split-inference-deployment.md §8 for the full walkthrough (creating the Space,
# uploading deploy/spaces/inference-vllm/, verifying it). `AURA_ALLOW_REMOTE_INFERENCE=true` is
# required because hf.space is a *gated*, not banned, host (aura_core/config/external_inference.py
# REMOTE_INFERENCE_HOSTS) -- a Space runs your own container/weights on rented compute, which is a
# legitimate but consequential choice (offline capability is lost; prompts/documents leave
# infrastructure you control) that must be opted into explicitly.
# AURA_ALLOW_REMOTE_INFERENCE=true
#
#   AURA_LLM_PROVIDERS=local,hfspace
#   AURA_PROVIDER_HFSPACE_KIND=openai_compatible
#   AURA_PROVIDER_HFSPACE_BASE_URL=https://<your-username>-aura-inference-vllm.hf.space/v1
#   AURA_PROVIDER_HFSPACE_MODEL=Qwen/Qwen2.5-7B-Instruct-AWQ
#   AURA_PROVIDER_HFSPACE_API_KEY_ENV=AURA_PROVIDER_HFSPACE_API_KEY
#   AURA_PROVIDER_HFSPACE_IS_LOCAL=false
#   AURA_PROVIDER_HFSPACE_QUALITY_TIER=2
#   AURA_PROVIDER_HFSPACE_CONTEXT_WINDOW=8192
#   AURA_PROVIDER_HFSPACE_TIMEOUT_S=45
#   AURA_PROVIDER_HFSPACE_MAX_CONCURRENCY=8
#
#   # The key itself, matching the Space's VLLM_API_KEY secret. Never in the provider block.
#   AURA_PROVIDER_HFSPACE_API_KEY=<same value as the Space's VLLM_API_KEY secret>
#
# is_local=false here is deliberate and the opposite of the `large` example above: it means "rented
# compute we don't own," which keeps `local_first` always ranking this behind `local` while
# Contabo/Ollama's circuit is closed -- it is reached only on failover (ADR-003's per-provider
# circuit breaker), never as a preferred path. TIMEOUT_S=45 is deliberately much shorter than a
# CPU Space's 300s: once warm, GPU vLLM answers in a few seconds, and a long timeout here would
# only make a genuinely dead Space hang the failover path. MAX_CONCURRENCY=8 reflects GPU batching
# versus a CPU Space's 2. If the Space's own storage isn't persistent, weights re-download on every
# cold start after it sleeps -- prefer an always-on GPU flavor for this node specifically, since an
# unreliable failover defeats the point.

# --- Embeddings --------------------------------------------------------------------------
# Changing either of these changes the index identity and forces a rebuild, by design (ADR-007).
AURA_EMBEDDING_PROVIDER=sentence-transformers
AURA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AURA_EMBEDDING_DIMENSION=384

# Hugging Face access token, read directly from the environment by huggingface_hub /
# sentence-transformers (not an AURA_* setting -- no aura_core code reads this name).
# Optional: weight downloads work unauthenticated, just subject to the Hub's lower anonymous
# rate limit. Set a real token (read-only access is enough) to avoid that on every cold model
# load. Deliberately not in BANNED_CREDENTIAL_NAMES (aura_core/config/external_inference.py) --
# it authenticates permitted model-weight downloads, not a paid inference API (SEC-01).
HF_TOKEN=

# --- Device attestation ------------------------------------------------------------------
# Production must refuse mock attestation (AuraSettings.validate fails closed).
# Debug Flutter APKs cannot mint real Play Integrity / App Attest tokens; point
# those builds at a *local* compose stack with ALLOW_MOCK_ATTESTATION=true, not
# this production host. Production compose defaults this to false.
ALLOW_MOCK_ATTESTATION=false
# Must stay false in staging/production. AuraSettings and legacy Settings refuse
# to boot if DEBUG_MODE or AURA_DEBUG is true in those environments.
DEBUG_MODE=false
# Apple Developer Team ID (10 characters). Required for iOS App Attest verify.
# App ID hashed into authData is APPLE_TEAM_ID.com.auraai.auraClient
APPLE_TEAM_ID=

# Router semaphore must match OLLAMA_NUM_PARALLEL=1 on this CPU box.
AURA_PROVIDER_LOCAL_MAX_CONCURRENCY=1

# --- Model lifecycle ---------------------------------------------------------------------
# Empty means model pulls are disabled. Fails closed: weights are executable artefacts
# fetched from a third party (SEC-01). Include both the CPU-default 3B and the
# previously installed 7B so either tag can be pulled / loaded without a compose edit.
AURA_MODEL_ALLOWLIST=qwen2.5:3b-instruct-q4_K_M,qwen2.5:7b-instruct-q4_K_M

# --- Engineer agent: GitHub ---------------------------------------------------------------
# Neither path below does anything by itself: a user also needs the "engineer_agent"
# capability (AURA_ENGINEER_AGENT_ROLES above) before either of these tools reaches them at
# all -- that capability is what unlocks the `engineer` persona, not these two flags.
# Both paths below are off by default and independent of each other and of
# AURA_SANDBOX_ENABLED (the engineer agent's filesystem/command/git tools) -- enabling one does
# not enable the others.
#
# --- Engineer agent: persistent workspaces (ADR-013) ---------------------------------------
# Turning this on gives the engineer agent a real, durable Docker workspace per (user,
# repository): a genuine git checkout with history that survives between turns and is deleted
# after three days without activity. Off by default, and it needs the `sandbox` compose profile.
# Set BOTH of these so a normal `vps-update.sh` / `docker compose up -d` brings the proxy and
# socket-proxy services up; `AURA_SANDBOX_ENABLED` alone only flips the gateway flag:
#   COMPOSE_PROFILES=sandbox
#   AURA_SANDBOX_ENABLED=true
# Or one-shot: docker compose -f deploy/docker-compose.prod.yml --profile sandbox up -d
#
# AURA_SANDBOX_ENABLED=true
# COMPOSE_PROFILES=sandbox
# The workspace root. This is a HOST path, and the compose file bind-mounts it into the gateway
# at the *same* path on purpose -- the Docker daemon resolves bind sources on the host, so a path
# that existed only inside the gateway would silently be a different, empty directory. Change
# both sides together or not at all.
# AURA_SANDBOX_HOST_ROOT=/opt/aura-stack/deploy/sandboxes
#
# Capacity. A workspace is *stopped* between turns rather than deleted, and a stopped container
# holds no memory -- so peak RAM is MAX_RUNNING * MEMORY_LIMIT no matter how many workspaces
# exist. The defaults assume the documented 24 GB host; on 16 GB, where this competes with
# Ollama for the same pages, use MAX_RUNNING=1 and MAX_WORKSPACES=2.
# AURA_SANDBOX_MAX_RUNNING=2
# AURA_SANDBOX_MAX_WORKSPACES=4
# AURA_SANDBOX_MEMORY_LIMIT=512m
# AURA_SANDBOX_CPU_LIMIT=1.0
# AURA_SANDBOX_WORKSPACE_DISK_QUOTA_MB=2048
#
# Refuse to start a workspace when the host has less than this much memory free. A refusal the
# agent can report beats an OOM kill choosing a victim -- the largest process here is the model
# server, so "start it and see" means someone else's chat dies for a build.
# AURA_SANDBOX_MIN_FREE_MEMORY_MB=1024
#
# Expiry, in hours since a workspace was last used (not since it was created, so one in daily
# use is never reaped). The reaper runs every 30 minutes; see celery_app.py's beat schedule.
# AURA_SANDBOX_WORKSPACE_TTL_HOURS=72
# Idle seconds before a still-running workspace is stopped to return its memory.
# AURA_SANDBOX_HOT_IDLE_S=900
#
# Egress. `sandbox_egress` is an internal network, so the tinyproxy sidecar is the only way out
# and it forwards solely to the hosts in deploy/sandbox/filter (GitHub, PyPI, npm). Edit that
# file to allow more -- every entry is somewhere a compromised workspace could send a checkout.
# AURA_SANDBOX_PROXY_URL=http://sandbox-proxy:8888
#
# Where git runs. Default (false) runs it in the gateway, so a private clone's token never
# enters a container executing model-chosen commands. Setting this true moves git inside the
# workspace and accepts that a command there can read the credential.
# AURA_SANDBOX_IN_CONTAINER_GIT=false

# Path 1 -- one shared admin token for the whole deployment. Every user's engineer-agent GitHub
# tool calls run as this one PAT.
# AURA_GITHUB_ENABLED=true
# AURA_GITHUB_DEFAULT_OWNER=your-org
# AURA_GITHUB_DEFAULT_REPO=your-repo
# Restricts the token to exactly these repos, regardless of what a model's tool arguments claim.
# AURA_GITHUB_ALLOWED_REPOS=your-org/your-repo
# The PAT itself (AURA_GITHUB_TOKEN) has no Docker-secret-file wiring in this compose file today
# -- unlike every secret below, it has to be passed as a plain environment value to the gateway
# service, e.g. in deploy/.env, which means it is visible to `docker inspect`/process listings
# (SEC-08 does not yet cover it).
#
# Path 2 -- each user connects their own GitHub account (a GitHub App's OAuth flow), so tool
# calls run against exactly the repos that user granted, not a shared token. Requires a GitHub
# App registered at github.com (Settings -> Developer settings -> GitHub Apps) with Contents,
# Pull requests, and Metadata permissions, and a callback URL matching
# AURA_GITHUB_OAUTH_CALLBACK_URL exactly.
# AURA_GITHUB_OAUTH_ENABLED=true  (vps-update.sh sets this itself once the two lines below
#                                  and the real client secret file are in place)
# AURA_GITHUB_OAUTH_CLIENT_ID=<the App's Client ID>
# AURA_GITHUB_OAUTH_CALLBACK_URL=https://169.58.188.43.nip.io/api/v3/integrations/github/callback
# The client secret and the token-encryption key are both file-backed secrets, not env vars here
# -- see docker-compose.prod.yml's `secrets:` block. bootstrap-secrets.sh generates
# deploy/secrets/secrets_encryption_key automatically; deploy/secrets/github_oauth_client_secret
# needs the real value from the GitHub App's settings page pasted in by hand before this is true:
#   printf '%s' "$CLIENT_SECRET" > deploy/secrets/github_oauth_client_secret

# --- Backups ---------------------------------------------------------------------------
BACKUP_PATH=./backups
BACKUP_RETENTION_DAYS=14
# Offsite copy after a successful local cycle. Leave BACKUP_S3_URI empty to skip.
# Retention offsite should be >= local. Credentials: deploy/secrets/rclone.conf
# or deploy/secrets/backup_s3_access_key + backup_s3_secret_key (never commit them).
# BACKUP_S3_URI=s3:my-bucket/aura
# BACKUP_S3_ENDPOINT=https://s3.example.com
# BACKUP_S3_PROVIDER=Other
# BACKUP_OFFSITE_RETENTION_DAYS=14

# --- Voice (TTS + Phase H live duplex) -------------------------------------------------
# Primary speaker is Piper (baked under /opt/piper/voices/ at image build).
# espeak-ng is last-resort only when a language's ONNX is missing.
# AURA_VOICE_PIPER_EN_MODEL=/opt/piper/voices/en_US-lessac-medium.onnx
# AURA_VOICE_PIPER_AR_MODEL=/opt/piper/voices/ar_JO-kareem-medium.onnx
# AURA_VOICE_PIPER_LENGTH_SCALE=1.08
# Fallback knobs (formant speech). espeak-ng stock is 175 wpm with no word gap.
# AURA_VOICE_TTS_VOICE=en-us
# AURA_VOICE_TTS_RATE_WPM=142
# AURA_VOICE_TTS_WORD_GAP=6
# AURA_VOICE_TTS_PITCH=45
# AURA_VOICE_TTS_AMPLITUDE=88
# AURA_VOICE_TTS_AR_VOICE=ar
# AURA_VOICE_TTS_AR_RATE_WPM=130
# Live WebSocket (/api/v3/voice/live). docker-compose.prod.yml defaults this to true;
# set false to refuse sessions (health/ready reports voice.live=false).
# AURA_VOICE_LIVE_ENABLED=true
# AURA_VOICE_LIVE_MAX_SESSIONS=8

# --- Alertmanager (AURA-015) -----------------------------------------------------------
# Incoming webhook (Discord/Slack/generic). Leave empty to keep receivers silent —
# do not use a placeholder URL that 404s. Never commit a live URL.
# Critical alerts (AuraGatewayDown, AuraInsecureModeActive, AuraAllProvidersUnhealthy)
# use ALERTMANAGER_CRITICAL_WEBHOOK_URL if set, otherwise this same URL.
ALERTMANAGER_WEBHOOK_URL=
# ALERTMANAGER_CRITICAL_WEBHOOK_URL=
# Optional: first non-comment line of this gitignored file is used if the env var is empty.
#   printf '%s\n' "$YOUR_DISCORD_OR_SLACK_WEBHOOK" > deploy/secrets/alertmanager_webhook_url
# ALERTMANAGER_WEBHOOK_URL_FILE=/run/secrets/alertmanager_webhook_url
# Optional SMTP (all three required to enable email):
# ALERTMANAGER_SMTP_SMARTHOST=smtp.example.com:587
# ALERTMANAGER_SMTP_FROM=aura-alerts@example.com
# ALERTMANAGER_SMTP_TO=ops@example.com
# ALERTMANAGER_SMTP_AUTH_USERNAME=
# ALERTMANAGER_SMTP_AUTH_PASSWORD=
# ALERTMANAGER_SMTP_REQUIRE_TLS=true
