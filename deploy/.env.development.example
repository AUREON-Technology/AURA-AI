# Copy to deploy/.env.development on the VPS. Secrets stay in deploy/secrets/ (shared with prod).

COMPOSE_PROJECT_NAME=aura-dev

# Dev subdomain — nip.io resolves to the same VPS IP as production.
AURA_DOMAIN=dev.169.58.188.43.nip.io
AURA_DEV_DOMAIN=dev.169.58.188.43.nip.io
AURA_ENVIRONMENT=development
AURA_WORKERS=2
AURA_LOG_LEVEL=DEBUG

# Browser / Flutter CORS for the dev host.
# ALLOWED_ORIGINS=https://dev.169.58.188.43.nip.io

# Operator allowlists (comma-separated). Console login requires Developer+.
SUPERADMIN_EMAILS=anas.ibrahim.gnedy@gmail.com
ADMIN_EMAILS=
DEVELOPER_EMAILS=

# --- LLM (shared prod Ollama over aura_edge) ---------------------------------------------
AURA_LLM_PROVIDERS=local
AURA_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_BASE_URL=http://ollama:11434/v1
AURA_LLM_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_MAX_CONCURRENCY=1

# --- Embeddings --------------------------------------------------------------------------
AURA_EMBEDDING_PROVIDER=sentence-transformers
AURA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AURA_EMBEDDING_DIMENSION=384

# --- Device attestation (dev only) -------------------------------------------------------
ALLOW_MOCK_ATTESTATION=true
DEBUG_MODE=false

# --- Model lifecycle ---------------------------------------------------------------------
AURA_MODEL_ALLOWLIST=qwen2.5:3b-instruct-q4_K_M,aura-ft:v1

# --- Loop B (lowered thresholds for console walkthrough) ---------------------------------
LEARNING_FINETUNE_MIN_EXAMPLES=12
LEARNING_FINETUNE_MIN_USERS=5
LEARNING_FINETUNE_ALLOW_CPU=true
AURA_FINETUNE_TRAINER=local

# --- Google OAuth (same client id as prod; add dev origin in Google Cloud Console) --------
# GOOGLE_CLIENT_ID=87789110323-5picq501c0834g6g0amjqqpk628jaoh2.apps.googleusercontent.com
