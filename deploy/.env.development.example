# Copy to deploy/.env.development on the VPS. Secrets stay in deploy/secrets/ (the directory is
# shared with prod, but the JWT signing key and data key are dev's own files: dev_jwt_secret and
# dev_data_encryption_keys, created by scripts/bootstrap-secrets.sh -- F-03).

COMPOSE_PROJECT_NAME=aura-dev

# Dev subdomain — DNS A record must point at the same VPS IP as production.
AURA_DOMAIN=dev.aureon-ai.tech
AURA_DEV_DOMAIN=dev.aureon-ai.tech
AURA_ENVIRONMENT=development
# Tokens are bound to iss=aura-development / aud=aura-api-development (derived from the line
# above), so prod refuses a dev token even apart from the separate signing key. Leave unset; see
# deploy/.env.example for AURA_JWT_ISSUER / AURA_JWT_AUDIENCE / AURA_JWT_LEGACY_TOKENS_UNTIL.
AURA_WORKERS=2
AURA_LOG_LEVEL=DEBUG

# Browser / Flutter CORS for the dev host.
# ALLOWED_ORIGINS=https://dev.aureon-ai.tech

# Operator allowlists (comma-separated). Console login requires Developer+.
# Only a verified Google sign-in is matched against them (SEC-08).
SUPERADMIN_EMAILS=anas.ibrahim.gnedy@gmail.com
ADMIN_EMAILS=
DEVELOPER_EMAILS=

# --- LLM (shared prod Ollama over aura_edge) ---------------------------------------------
AURA_LLM_PROVIDERS=local
AURA_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_MODEL=qwen2.5:3b-instruct-q4_K_M
AURA_PROVIDER_LOCAL_BASE_URL=http://ollama:11434/v1
AURA_LLM_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_TIMEOUT_S=180
AURA_PROVIDER_LOCAL_MAX_CONCURRENCY=1

# --- Embeddings --------------------------------------------------------------------------
AURA_EMBEDDING_PROVIDER=sentence-transformers
AURA_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
AURA_EMBEDDING_DIMENSION=384

# --- Device attestation (dev only) -------------------------------------------------------
ALLOW_MOCK_ATTESTATION=true
DEBUG_MODE=false

# --- Encryption at rest (memories + personal-OS records) --------------------------------
# File-backed secret deploy/secrets/dev_data_encryption_keys (mounted as data_encryption_keys,
# AURA_DATA_ENCRYPTION_KEYS_FILE) -- dev's own key, never prod's, so dev cannot decrypt prod
# rows (F-03, GAP-047). See deploy/.env.example's section of the same name for rotation. Optional under AURA_ENVIRONMENT=development
# (without it rows are stored in plaintext and a warning is logged), but compose wires it so
# the dev stack runs the encrypted path. Generate by hand with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# AURA_DATA_ENCRYPTION_KEYS=<only for running outside compose; newest key first>

# --- Model lifecycle ---------------------------------------------------------------------
AURA_MODEL_ALLOWLIST=qwen2.5:3b-instruct-q4_K_M,aura-ft:v1

# --- Loop B (lowered thresholds for console walkthrough) ---------------------------------
LEARNING_FINETUNE_MIN_EXAMPLES=12
LEARNING_FINETUNE_MIN_USERS=5
LEARNING_FINETUNE_ALLOW_CPU=true
# AURA_FINETUNE_TRAINER is not read from here: the compose files pin the gateway to `scripted`
# (never trains) and worker-training to `local` (real PEFT LoRA). The seed trains on this HF id:
# AURA_SEED_FINETUNE_BASE_MODEL=HuggingFaceTB/SmolLM2-135M-Instruct

# --- Google OAuth (console uses Google Identity Services; same client id as prod) ----------
# GOOGLE_CLIENT_ID=87789110323-5picq501c0834g6g0amjqqpk628jaoh2.apps.googleusercontent.com
#
# If sign-in shows "Error 400: origin_mismatch", add Authorized JavaScript origins in
# Google Cloud Console (APIs & Services -> Credentials -> your OAuth 2.0 Client ID):
#   https://dev.aureon-ai.tech
#   https://aureon-ai.tech
# (no trailing slash; scheme must be https.)
#
# The console login page uses GIS button flow (id token), not a browser redirect URI.
# Authorized redirect URIs are not required for /console/login unless you add redirect-based OAuth.
#
# After saving in Google Cloud, wait ~1 minute and retry sign-in on:
#   https://dev.aureon-ai.tech/console/login
