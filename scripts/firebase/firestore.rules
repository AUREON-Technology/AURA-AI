rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users can only read and write their own private documents
    match /users/{userId}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
    
    // Global configuration metadata parameters read-only to authenticated users
    match /config/{document=**} {
      allow read: if request.auth != null;
      allow write: if false; // Only cloud function admin sdk can modify configuration
    }
  }
}
