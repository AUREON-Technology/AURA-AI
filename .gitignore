# ==========================================
# Secrets / credentials — never commit
# ==========================================
tmp_*
credentials.json
**/credentials.json
*.env
.env
.env.*
!deploy/.env.development.example
!.env.example
Deployment_info.txt
**/Deployment_info.txt
google_client_id.txt
*.pem
*.key
*.p12
service-account*.json
roles.json

aura-ai-89ab4-firebase-adminsdk-fbsvc-8123ff090c.json

# SSH keys. `*.key` above does not match them: ssh-keygen names its output `id_ed25519`,
# `aura_deploy` or whatever -f was given, with no extension at all. A deploy key committed here
# would be readable by everyone with repo access and would stay in history after deletion.
id_rsa
id_ecdsa
id_ed25519
id_*[!.]
*_rsa
*_ed25519
*_deploy
!*.pub
known_hosts
# ...but deploy/known_hosts is the VPS host-key pin the deploy workflow copies into
# ~/.ssh before it will SSH anywhere. A host key is public by construction -- pinning it
# is what stops the deploy trusting an impostor -- so it must be committed. The rule above
# is about a developer's personal known_hosts, and it silently swallowed this file: the
# workflow failed 25 consecutive times on `cp: cannot stat 'deploy/known_hosts'`.
!deploy/known_hosts

# VPS log exports (operational dumps — large, may contain sensitive runtime data)
docs/reports/vps-logs-*.log

# ==========================================
# Python (aura_backend)
# ==========================================
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
*.egg-info/
local_qdrant_storage/
test_local_db/
learning_logs.json
routing_centroids.json
sentiment_centroids.json
telemetry_logs.jsonl
train_lora.json
aura_backend/scratch/

# ==========================================
# Flutter / Dart (aura_client)
# ==========================================
aura_client/build/
# Every Dart package, not just the client: aura_hostd is a Dart package too, and scoping this to
# one directory is how 33 MB of build output (a 29 MB test snapshot, a 4.4 MB incremental kernel)
# reached the repository.
**/.dart_tool/
aura_client/.flutter-plugins
aura_client/.flutter-plugins-dependencies
aura_client/android/.gradle/
aura_client/android/.kotlin/
aura_client/android/local.properties
aura_client/ios/Pods/
aura_client/scratch_test_*.tmp

# ==========================================
# Dart (aura_hostd) — compiled daemon binaries
# ==========================================
# A stale compiled aura_hostd.exe checked into git ran old server code well after the routes and
# fixes it predated had landed in source -- the Desktop IDE kept calling into a daemon binary that
# had never seen those changes, and nothing about `git log` or a merged PR made that visible.
aura_hostd/build/
# scripts/real_desktop_path.sh: the locked `websockets` pin, when the venv lacks it
aura_backend/.real_desktop_lib/
aura_hostd/*.exe
# `dart compile exe` with no -o names the output after the entrypoint, with no extension on Linux
# and macOS -- and a 7.3 MB Windows build was committed under exactly that name.
aura_hostd/aura_hostd

# ==========================================
# Build artefacts, logs and local databases — anywhere in the tree (audit F-37, CB-13)
# ==========================================
# An ignore rule does not untrack a file that is already in the index, so
# scripts/check_tracked_artifacts.py checks `git ls-files` itself; keep the two in step.
# Releases ship as CI artifacts (release-apk.yml) or GitHub Release assets, never as commits.
aura_client/releases/
*.apk
*.aab
*.ipa
*.exe
*.dll
*.dylib
*.log
*.log.err
*.db
*.sqlite
*.sqlite3
*.tsbuildinfo

# ==========================================
# Node (repo root)
# ==========================================
# Each Node project under this repo (aura_admin, aura_client's own tooling) already ignores its
# own node_modules/ via its own .gitignore -- this covers a root-level npm install instead, which
# nothing else in this file excludes.
/node_modules/

# ==========================================
# IDE / OS
# ==========================================
.idea/
.vscode/
.cursor/
*.iml
.DS_Store
Thumbs.db

# Coverage and pytest artefacts
.coverage
.coverage.*
htmlcov/
.pytest_cache/

# Neural TTS voices — baked into the gateway image, never committed
*.onnx

# ==========================================
# Node (root-level tooling, e.g. MCP servers)
# ==========================================
node_modules/

# Built host daemon binary — build it locally with `dart run bin/aura_hostd.dart` / a release build
aura_hostd/aura_hostd.exe

# The finished Windows installer + latest.json are dropped here by desktop-main-channel.yml before a
# deploy of the web service; never commit them (binaries belong in the image, not the tree).
aura_web/build-assets/*
!aura_web/build-assets/.gitkeep

# The Flutter web build, dropped here by web-app-main-channel.yml before a deploy of the web
# service; never commit it (it is 48 MB of generated files).
aura_web/app-build/*
!aura_web/app-build/.gitkeep
