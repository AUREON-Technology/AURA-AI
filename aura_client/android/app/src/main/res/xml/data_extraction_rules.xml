<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (API 31+) Auto Backup / device-transfer rules.

  .aura_db_key (EncryptionKeyBackup, core/security/encryption_key_backup.dart)
  mirrors the Drift DB encryption key in plaintext as a resilience fallback for
  flutter_secure_storage failures. Without this exclusion, Android's default
  Auto Backup (android:allowBackup defaults to true, and this app sets no
  override) would silently include that plaintext key in every cloud/device
  backup -readable by anyone who can restore or extract the backup archive.

  path_provider's getApplicationSupportDirectory() resolves on Android to
  Context.getFilesDir() itself (path_provider_android 2.3.x:
  getApplicationSupportPath() returns filesDir), so the key file is
  files/.aura_db_key, i.e. domain="file" path=".aura_db_key". These rules used
  to name app_flutter/.aura_db_key -a path under filesDir that does not exist
  (app_flutter is getDir("flutter"), the *documents* directory, outside
  filesDir) -so the plaintext key went into every backup. The old path stays
  excluded as well, in case a future path_provider moves the support
  directory there. test/android_backup_rules_test.dart pins both.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path=".aura_db_key"/>
        <exclude domain="file" path="app_flutter/.aura_db_key"/>
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path=".aura_db_key"/>
        <exclude domain="file" path="app_flutter/.aura_db_key"/>
    </device-transfer>
</data-extraction-rules>
