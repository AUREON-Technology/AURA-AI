  "engineerConsentTitle": "The Engineer uses Claude, by Anthropic",
  "@engineerConsentTitle": {
    "description": "Engineer consent notice, version 2026-11-17 (kEngineerConsentNoticeVersion). Owner-reviewed wording: change it only together with that constant and the backend's CURRENT_NOTICE_VERSION. Title."
  },
  "engineerConsentBodyWhat": "To work on your code, the Engineer sends what it reads and runs to Claude, an AI model run by Anthropic, a company outside AURA.",
