{
  "openapi": "3.1.0",
  "info": {
    "title": "Reference Shop API",
    "version": "2.0.1",
    "description": "Catalogue, orders and returns for the reference shop."
  },
  "servers": [{"url": "https://shop.example.com/api"}],
  "paths": {
    "/products": {
      "get": {
        "operationId": "listProducts",
        "summary": "List products in a category.",
        "tags": ["catalogue"],
        "parameters": [
          {"name": "category", "in": "query", "schema": {"type": "string"}},
          {"name": "inStock", "in": "query", "schema": {"type": "boolean"}}
        ],
        "responses": {
          "200": {
            "description": "Products.",
            "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Product"}}}}
          }
        }
      }
    },
    "/products/{sku}": {
      "get": {
        "operationId": "getProduct",
        "tags": ["catalogue"],
        "parameters": [{"name": "sku", "in": "path", "required": true, "schema": {"type": "string"}}],
        "responses": {
          "200": {"description": "The product.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Product"}}}}
        }
      }
    },
    "/customers/{customerId}/orders": {
      "get": {
        "operationId": "listCustomerOrders",
        "summary": "Orders placed by one customer.",
        "tags": ["orders"],
        "parameters": [{"name": "customerId", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "200": {"description": "Orders.", "content": {"application/json": {"schema": {"type": "array", "items": {"$ref": "#/components/schemas/Order"}}}}}
        }
      }
    },
    "/orders/{orderId}": {
      "get": {
        "operationId": "getOrder",
        "tags": ["orders"],
        "parameters": [{"name": "orderId", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {
          "200": {"description": "The order.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Order"}}}}
        }
      },
      "delete": {
        "operationId": "cancelOrder",
        "tags": ["orders"],
        "deprecated": true,
        "parameters": [{"name": "orderId", "in": "path", "required": true, "schema": {"type": "integer"}}],
        "responses": {"204": {"description": "Cancelled."}}
      }
    },
    "/returns": {
      "post": {
        "operationId": "createReturn",
        "tags": ["returns"],
        "requestBody": {
          "required": true,
          "content": {"application/json": {"schema": {"$ref": "#/components/schemas/NewReturn"}}}
        },
        "responses": {
          "201": {"description": "Return opened.", "content": {"application/json": {"schema": {"$ref": "#/components/schemas/Return"}}}}
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "apiKey": {"type": "apiKey", "in": "header", "name": "X-Shop-Key"}
    },
    "schemas": {
      "Product": {
        "type": "object",
        "required": ["sku", "title", "price"],
        "properties": {
          "sku": {"type": "string"},
          "title": {"type": "string"},
          "category": {"type": "string"},
          "price": {"type": "number"},
          "stock": {"type": "integer"}
        }
      },
      "OrderItem": {
        "type": "object",
        "properties": {
          "sku": {"type": "string"},
          "qty": {"type": "integer"},
          "unitPrice": {"type": "number"}
        }
      },
      "Order": {
        "type": "object",
        "required": ["id", "customerId", "status"],
        "properties": {
          "id": {"type": "integer"},
          "customerId": {"type": "integer"},
          "status": {"type": "string", "enum": ["placed", "paid", "shipped", "delivered", "cancelled", "returned"]},
          "placedAt": {"type": "string", "format": "date-time"},
          "items": {"type": "array", "items": {"$ref": "#/components/schemas/OrderItem"}},
          "total": {"type": "number"}
        }
      },
      "NewReturn": {
        "type": "object",
        "required": ["orderId", "sku", "reason"],
        "properties": {
          "orderId": {"type": "integer"},
          "sku": {"type": "string"},
          "reason": {"type": "string"}
        }
      },
      "Return": {
        "type": "object",
        "properties": {
          "id": {"type": "integer"},
          "orderId": {"type": "integer"},
          "sku": {"type": "string"},
          "reason": {"type": "string"}
        }
      }
    }
  },
  "security": [{"apiKey": []}]
}
