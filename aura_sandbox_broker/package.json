{
  "name": "aura-sandbox-broker",
  "version": "0.1.0",
  "private": true,
  "description": "Holds the Railway token and fixes the safety settings for AURA's cloud sandboxes.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test \"dist/test/**/*.test.js\"",
    "start": "node dist/src/main.js"
  },
  "dependencies": {
    "railway": "3.17.0"
  },
  "devDependencies": {
    "@types/node": "22.20.7",
    "typescript": "5.9.3"
  }
}
