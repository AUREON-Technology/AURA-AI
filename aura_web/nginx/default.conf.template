# AURA web service: the AURA web app (/app/, the Flutter web build of the mobile app) and the
# public install page for the Desktop IDE (/desktop-ide/).
#
# The two have different security policies on purpose. The install page ships its own CSS and JS
# and nothing else, so it runs under `default-src 'none'` (security-headers.conf). The Flutter app
# needs WebAssembly, a worker, the API and Firebase sign-in, so /app/ includes its own,
# wider policy (security-headers-app.conf). A location that sets add_header drops the server-level
# ones, so each location includes the snippet it wants.
#
# nginx-unprivileged renders this file through envsubst at start-up (docker-entrypoint), which
# substitutes only variables that exist in the environment: ${PORT} comes from Railway; nginx's
# own $uri etc. are left alone. Locally: `docker run -e PORT=8080 -p 8080:8080 <image>`.

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;
    charset utf-8;
    server_tokens off;
    # Railway's edge terminates TLS and proxies to the container: a redirect must not carry the
    # container's internal port or scheme.
    absolute_redirect off;

    gzip on;
    gzip_types text/css application/javascript application/json application/wasm image/svg+xml;

    include /etc/nginx/snippets/security-headers.conf;

    # The web app is the front door; the installer stays one link away.
    location = / { return 302 /app/; }
    location = /desktop-ide { return 302 /desktop-ide/install; }
    location = /desktop-ide/ { return 302 /desktop-ide/install; }
    location = /desktop-ide/install/ { return 301 /desktop-ide/install; }

    # ---- The web app: the Flutter web build, copied into the image from aura_web/app-build ----
    # (filled by .github/workflows/web-app-main-channel.yml; with no build there, the image carries
    # a plain "not built yet" page instead, so /app/ never 404s into the installer's 404 page).
    # Hash routing means the browser never asks for a client-side route, so there is no general
    # SPA fallback: a missing file is a real 404, not an HTML page served in place of a script.
    # The exceptions are the two links that are opened as real paths from outside the app, which
    # the app reads back into its router (router.dart `webDeepLinkLocation`): a team invite
    # (/app/invite?token=...) and the desktop app's browser sign-in (/app/desktop-sign-in?...).
    location = /app { return 301 /app/; }

    location = /app/invite {
        include /etc/nginx/snippets/security-headers-app.conf;
        add_header Cache-Control "no-store" always;
        try_files /app/index.html =404;
    }
    location = /app/desktop-sign-in {
        include /etc/nginx/snippets/security-headers-app.conf;
        add_header Cache-Control "no-store" always;
        try_files /app/index.html =404;
    }

    # Dotfiles (.gitkeep, .last_build_id) are not served.
    location ~ ^/app/\. { return 404; }

    # Big, rarely changing, and named by the build: one day.
    location ~ ^/app/(canvaskit|assets|icons)/ {
        include /etc/nginx/snippets/security-headers-app.conf;
        add_header Cache-Control "public, max-age=86400" always;
        try_files $uri =404;
    }

    # The shell, the loader, the compiled app and the version stamp: always revalidated, so a new
    # deploy is picked up on the next load and never mixes with an old main.dart.js.
    location /app/ {
        include /etc/nginx/snippets/security-headers-app.conf;
        add_header Cache-Control "no-cache" always;
        try_files $uri $uri/index.html =404;
    }

    # Railway's health check; deliberately not under /desktop-ide.
    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # The page itself. Never cached for long: the checksum on it changes with the setup file.
    location = /desktop-ide/install {
        default_type text/html;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        try_files /desktop-ide/install.html =404;
    }

    location /desktop-ide/assets/ {
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "public, max-age=3600" always;
        try_files $uri =404;
    }

    # ---- Downloads. Exactly three names are served; everything else under /download/ is a 404. ----
    # The installer and its manifest are copied into the image at build time (aura_web/build-assets,
    # filled by .github/workflows/desktop-main-channel.yml), so they always belong together: one
    # deploy replaces both. Nothing is cached without revalidation, so a new build is picked up at
    # once and a stale copy can never disagree with latest.json.

    # The setup file. Served as a download, never rendered.
    location = /desktop-ide/download/AURA-Desktop-Setup.cmd {
        default_type application/octet-stream;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Content-Disposition 'attachment; filename="AURA-Desktop-Setup.cmd"' always;
        try_files $uri =404;
    }

    # What the latest build is: commit, version, installer name, size and SHA-256. Read by the
    # setup file and by the install page. Absent until the first build has been deployed (404).
    location = /desktop-ide/download/latest.json {
        default_type application/json;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-store" always;
        try_files $uri =404;
    }

    # The installer itself (Inno Setup, aura_hostd bundled). nginx serves byte ranges, so a
    # download can resume.
    location = /desktop-ide/download/aura-desktop-windows-x64-setup.exe {
        default_type application/octet-stream;
        include /etc/nginx/snippets/security-headers.conf;
        add_header Cache-Control "no-cache" always;
        add_header Content-Disposition 'attachment; filename="aura-desktop-windows-x64-setup.exe"' always;
        try_files $uri =404;
    }

    error_page 404 /404.html;
    location = /404.html {
        internal;
        include /etc/nginx/snippets/security-headers.conf;
    }

    # Nothing else is served: no directory listings, no stray files.
    location / { return 404; }
}
